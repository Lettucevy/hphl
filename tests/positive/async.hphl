// async.hphl — async/await (spec §10, v0.22.3): função async roda numa thread
// e a chamada devolve task<T> imediatamente; `await` espera a conclusão e
// devolve o payload (hphl_wait_task). contador é atomic (escrita de 4 threads).
atomic int contador = 0;

async int Dobrar(int x) {
    contador += 1;
    return x * 2;
}

async int SomaPar(int x, int y) {
    // espera duas tarefas em sequência (cada await bloqueia esta thread)
    return await Dobrar(x) + await Dobrar(y);
}

void Main() {
    task<int> t1 = SomaPar(20, 21);
    task<int> t2 = SomaPar(1, 2);
    int a = await t1; // 40 + 42 = 82
    int b = await t2; // 2 + 4 = 6
    print("a = ");
    print(a);
    print("\n");
    print("b = ");
    print(b);
    print("\n");
    print("contador = ");
    print(contador); // 4 chamadas a Dobrar
    print("\n");
    print("done\n");
}