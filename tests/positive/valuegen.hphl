// valuegen.hphl — genéricos com valor (M10 v0.45): `const int N` é parte do
// tipo, inclusive como dimensão simbólica de array de campo (`T[N] data`)
class Buffer<T, const int N> {
    public T[N] data;
    public int Cap() { return N; }
    public void Set(int i, T v) { data[i] = v; }
    public T Get(int i) { return data[i]; }
    public int Len() { return data.Length; }
}
void Main() {
    Buffer<int, 4> b1;
    Buffer<int, 8> b2;
    for (var i = 0; i < 4; i += 1) {
        b1.Set(i, i * 10);
    }
    for (var i = 0; i < 8; i += 1) {
        b2.Set(i, i);
    }
    print(b1.Cap());
    println();
    print(b2.Cap());
    println();
    int n1 = b1.Len();
    print(n1);
    println();
    var n2 = b2.Len();
    print(n2);
    println();
    print(b1.Get(3));
    println();
    print(b2.Get(7));
    println();
    print("done");
}
