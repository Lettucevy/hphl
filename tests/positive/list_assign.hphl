// B10: list assignment test
void Main() {
    list<int> xs;
    xs.Add(1);
    xs.Add(2);
    print(xs.Length);
    print("\n");

    list<int> ys;
    ys.Add(10);
    ys.Add(20);
    ys.Add(30);
    ys.Add(40);
    print(ys.Length);
    print("\n");

    xs = ys;
    print(xs.Length);
    print("\n");
    print(xs[0]);
    print("\n");
    print(xs[3]);
    print("\n");
}
