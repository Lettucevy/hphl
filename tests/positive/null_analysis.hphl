// null_analysis.hphl — padrões seguros segundo a Null Analysis (M11.7):
// `?.` + `??`, guarda `if (p != null)` e re-atribuição não-null
class P {
    public int v;
    P(int x) { this.v = x; }
}

void Main() {
    P p = null;
    int a = p?.v ?? -1;        // acesso condicional com default
    println(a);                // -1

    if (p != null) {
        println(p.v);          // guardado: ok no ramo do !=
    } else {
        println(0);            // ramo do ==: p é null aqui
    }

    p = new P(5);              // reassigned: deixa de ser possivelmente-null
    println(p.v);              // 5
}
