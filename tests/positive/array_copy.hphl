// B9: cópia de array (a = b para arrays stack)
void Main() {
    int[3] a = {1, 2, 3};
    int[3] b = {4, 5, 6};
    a = b;
    print(a[0]);
    print("\n");
    print(a[1]);
    print("\n");
    print(a[2]);
    print("\n");

    // matriz 2D
    int[2][2] m1 = {{1, 2}, {3, 4}};
    int[2][2] m2 = {{5, 6}, {7, 8}};
    m1 = m2;
    print(m1[0][0]);
    print("\n");
    print(m1[1][1]);
    print("\n");
}
