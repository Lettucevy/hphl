// async_array.hphl - item 2.9 (A9): array como parâmetro.
// Param array guarda o ponteiro da base (slot único); async copia os dados
// para dentro do env (lifetime: env é liberado no fim da task). Sync usa
// referência (mutação visível no caller).
async int SumarArray(int[3] arr) {
  return arr[0] + arr[1] + arr[2];
}

async int Mix(int[2] a, int scale, int[3] b) {
  return (a[0] + a[1]) * scale + b[0] + b[1] + b[2];
}

int SomaSync(int[3] arr) {
  return arr[0] + arr[1] + arr[2];
}

void Double(int[3] arr) {
  arr[0] = arr[0] * 2;
}

class Acc {
  int b0;
  Acc(int b) { this.b0 = b; }
  async int SumArr(int[2] xs) {
    return this.b0 + xs[0] + xs[1];
  }
}

void Main() {
  int[3] a;
  a[0] = 10; a[1] = 20; a[2] = 30;

  // async com array
  task<int> t = SumarArray(a);
  assert(t.Wait() == 60);

  // sync com array (leitura)
  assert(SomaSync(a) == 60);

  // sync com array (escrita — referência)
  Double(a);
  assert(a[0] == 20);

  // async com múltiplos arrays + escalar misturados
  int[2] x;
  x[0] = 1; x[1] = 2;
  int[3] y;
  y[0] = 10; y[1] = 20; y[2] = 30;
  task<int> t2 = Mix(x, 100, y);
  assert(t2.Wait() == 360);

  // método async (this no env) com array
  var acc = new Acc(1000);
  task<int> t3 = acc.SumArr(x);
  assert(t3.Wait() == 1003);

  print("async_array ok\n");
}