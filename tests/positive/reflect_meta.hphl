// reflect_meta.hphl — reflexão opt-in (M10.1c v0.46, spec §40):
// `reflect Nome;` habilita metadados consultáveis EM COMPILAÇÃO —
// SizeOf/FieldCount/HasField/FieldOffset dobram para constantes
// (custo zero no executável final)
class Ponto {
    public int x;
    private int y;
}

class Marcador : Ponto {
    public string tag;
}

reflect Ponto;
reflect Marcador;

void Main() {
    print(SizeOf(Ponto));
    println();
    print(SizeOf(Marcador));
    println();
    print(FieldCount(Marcador));
    println();
    print(HasField(Marcador, "y"));
    println();
    print(HasField(Ponto, "tag"));
    println();
    print(FieldOffset(Marcador, "tag"));
}
