void Main() {
    // Test float<32, saturate> - should clamp
    float<32, saturate> a = 1e30;
    float<32, saturate> b = 1e30;
    float<32, saturate> c = a * b; // overflow to inf, then clamp to FLT_MAX
    print(c);
    print("\n");
    
    // Test float<32, checked> - normal operations should work
    float<32, checked> x = 1.5;
    float<32, checked> y = 2.5;
    float<32, checked> z = x * y; // 3.75
    print(z);
    print("\n");
}