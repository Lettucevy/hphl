    string[32] brkLbl;

    string[32] cntLbl;

    int lblSp;



    void GenFn(Decl d) {
        this.nextSlot = 12; // reserva slots de this/d + margem (evita sobreposicao) + margem
        for (int q = 0; q < 2048; q++) this.lAtomic[q] = false;
        for (int q = 0; q < 2048; q++) this.lIsPtr[q] = false;

