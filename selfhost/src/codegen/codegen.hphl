                    if (1 + cn0 > 4) stkC0 = (1 + cn0) - 4;
                    int bytesC0 = (32 + stkC0 * 8 + 15) & -16;
                    this.Emit("subq $" + bytesC0 + ", %rsp");
                    this.Emit("movq " + this.Off(t) + ", %rcx");
                    if (cn0 > 0) this.Emit("movq " + this.Off(cargs0[0]) + ", %rdx");
                    if (cn0 > 1) this.Emit("movq " + this.Off(cargs0[1]) + ", %r8");
                    if (cn0 > 2) this.Emit("movq " + this.Off(cargs0[2]) + ", %r9");
                    int sci = 3;
                    while (sci < cn0) {
                        int k = sci + 1;
                        this.Emit("movq " + this.Off(cargs0[sci]) + ", %rax");
                        this.Emit("movq %rax, " + (32 + 8 * (k - 4)) + "(%rsp)");
                        sci = sci + 1;
                    }
                    this.Emit("call _sh_" + clsName + "_" + clsName + "_" + cn0);
                    this.Emit("addq $" + bytesC0 + ", %rsp");
