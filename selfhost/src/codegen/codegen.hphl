            return tr;

        }

        if (n.recv == null && (n.text == "toString" || n.text == "to_string")) {
            int sa = this.GenExpr(n.arg);
            this.Emit("movq " + this.Off(sa) + ", %rcx");
            this.Emit("subq $32, %rsp");
