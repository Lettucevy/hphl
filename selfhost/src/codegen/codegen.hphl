                if (cd0 != null) {
                    int[16] cargs0;
                    int cn0 = 0;
                    Pm cp0 = cd0.params != null ? cd0.params.next : null;
                    while (cp0 != null && cn0 < 15) {
                        if (cp0.defVal != null) {
