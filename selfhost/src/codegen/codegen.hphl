            this.Emit("addq $32, %rsp");
            int trm = this.NewTmp();
            this.Emit("movq %rax, " + this.Off(trm));
            return trm;
        }

        if (n.recv == null && n.text == "mem_zero") {
            int[2] mz;
            Node az = n.arg;
            int iz = 0;
            while (az != null && iz < 2) { mz[iz] = this.GenExpr(az); iz = iz + 1; az = az.next; }
            this.Emit("movq " + this.Off(mz[0]) + ", %rcx");
            this.Emit("movq " + this.Off(mz[1]) + ", %rdx");
            this.Emit("subq $32, %rsp");
            this.Emit("call hphl_mem_zero");
            this.Emit("addq $32, %rsp");
            int trz = this.NewTmp();
            this.Emit("movq $0, %rax");
            this.Emit("movq %rax, " + this.Off(trz));
            return trz;
        }

        if (n.recv == null && (n.text == "mem_poke_u32" || n.text == "mem_poke_i32" ||
            n.text == "mem_poke_i64" || n.text == "mem_poke_f32" ||
            n.text == "mem_poke_f64" || n.text == "mem_poke_ptr")) {
            string hf = "hphl_" + n.text;
            int[3] mp;
            Node ap = n.arg;
            int ip = 0;
            while (ap != null && ip < 3) { mp[ip] = this.GenExpr(ap); ip = ip + 1; ap = ap.next; }
            this.Emit("movq " + this.Off(mp[0]) + ", %rcx");
            this.Emit("movq " + this.Off(mp[1]) + ", %rdx");
            this.Emit("movq " + this.Off(mp[2]) + ", %r8");
            this.Emit("subq $32, %rsp");
            this.Emit("call " + hf);
            this.Emit("addq $32, %rsp");
            int trp = this.NewTmp();
            this.Emit("movq $0, %rax");
            this.Emit("movq %rax, " + this.Off(trp));
            return trp;
        }

        if (n.recv == null && (n.text == "mem_peek_u32" || n.text == "mem_peek_i32" ||
            n.text == "mem_peek_i64" || n.text == "mem_peek_f32" ||
            n.text == "mem_peek_f64" || n.text == "mem_peek_ptr")) {
            string hf = "hphl_" + n.text;
            int[2] mq;
            Node aq = n.arg;
            int iq = 0;
            while (aq != null && iq < 2) { mq[iq] = this.GenExpr(aq); iq = iq + 1; aq = aq.next; }
            this.Emit("movq " + this.Off(mq[0]) + ", %rcx");
            this.Emit("movq " + this.Off(mq[1]) + ", %rdx");
            this.Emit("subq $32, %rsp");
            this.Emit("call " + hf);
            this.Emit("addq $32, %rsp");
            int trq = this.NewTmp();
            this.Emit("movq %rax, " + this.Off(trq));
            return trq;
        }

        if (n.text == "print" || n.text == "println") {

            Node marg = n.arg;

            while (marg != null) {

                int a = this.GenExpr(marg);

                if (marg.tyHint == "float" || marg.tyHint == "double" || contains(marg.tyHint, "float") || contains(marg.tyHint, "double")) {

                    this.Emit("movq " + this.Off(a) + ", %rax");

                    this.Emit("movq %rax, %xmm0");

                    this.Emit("subq $32, %rsp");

                    this.Emit("call hphl_print_float");

                    this.Emit("addq $32, %rsp");

                } else if (marg.tyHint == "bool" || starts_with(marg.tyHint, "bool<")) {

