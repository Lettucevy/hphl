        if ((n.op == "==" || n.op == "!=") &&

            (n.left.tyHint == "string" || n.right.tyHint == "string")) {

            int a = this.GenExpr(n.left);

            int b = this.GenExpr(n.right);

            int t = this.NewTmp();

            this.Emit("movq " + this.Off(a) + ", %rcx");

            this.Emit("movq " + this.Off(b) + ", %rdx");

            this.Emit("subq $32, %rsp");

            this.Emit("call hphl_str_eq");

            this.Emit("addq $32, %rsp");

            if (n.op == "!=") {

                this.Emit("xorq $1, %rax");

            }

            this.Emit("movq %rax, " + this.Off(t));

            return t;

        }

        // + entre strings â†’ hphl_str_concat (com coerÃ§Ã£o escalarâ†’string,

        // espelhando o ToStr que o compilador nativo insere no HIR)

        if (n.op == "+" && n.tyHint == "string") {

            int a2 = this.GenExpr(n.left);

            if (n.left.tyHint != "" && n.left.tyHint != "string") {

                this.Emit("movq " + this.Off(a2) + ", %rcx");

                this.Emit("subq $32, %rsp");

                this.Emit("call hphl_str_from_int");

                this.Emit("addq $32, %rsp");

                a2 = this.NewTmp();

                this.Emit("movq %rax, " + this.Off(a2));

            }

            int b2 = this.GenExpr(n.right);

            if (n.right.tyHint != "" && n.right.tyHint != "string") {

                this.Emit("movq " + this.Off(b2) + ", %rcx");

                this.Emit("subq $32, %rsp");

                this.Emit("call hphl_str_from_int");

                this.Emit("addq $32, %rsp");

                b2 = this.NewTmp();

                this.Emit("movq %rax, " + this.Off(b2));

            }

            int t2 = this.NewTmp();

            this.Emit("movq " + this.Off(a2) + ", %rcx");

            this.Emit("movq " + this.Off(b2) + ", %rdx");

            this.Emit("subq $32, %rsp");

            this.Emit("call hphl_str_concat");

            this.Emit("addq $32, %rsp");

            this.Emit("movq %rax, " + this.Off(t2));

            return t2;

        }

        // M15.2.2: ==/!= com literal string â†’ comparaÃ§Ã£o POR CONTEÃšDO

        if ((n.op == "==" || n.op == "!=") &&

            (n.left.kind == NK.Str || n.right.kind == NK.Str)) {

            int a = this.GenExpr(n.left);

            int b = this.GenExpr(n.right);

            int t = this.NewTmp();

            this.Emit("movq " + this.Off(a) + ", %rcx");

            this.Emit("movq " + this.Off(b) + ", %rdx");

            this.Emit("subq $32, %rsp");

            this.Emit("call hphl_str_eq");

            this.Emit("addq $32, %rsp");

            if (n.op == "!=") {

                this.Emit("xorq $1, %rax");

            }

            this.Emit("movq %rax, " + this.Off(t));

            return t;

        }

        // M15.2.2: concat '+' quando um lado é string
        bool isStrBin = n.op == "+" && (n.left.kind == NK.Str || n.right.kind == NK.Str ||
                                        n.left.tyHint == "string" || n.right.tyHint == "string" ||
                                        (n.left.kind == NK.Var && this.LocalType(n.left.text) == "string") ||
                                        (n.right.kind == NK.Var && this.LocalType(n.right.text) == "string"));
        if (isStrBin) {

            int a = this.GenExpr(n.left);

            int b = this.GenExpr(n.right);

            int t = this.NewTmp();

            this.Emit("movq " + this.Off(a) + ", %rcx");

            this.Emit("movq " + this.Off(b) + ", %rdx");

            this.Emit("subq $32, %rsp");

            this.Emit("call hphl_str_concat");

            this.Emit("addq $32, %rsp");

            this.Emit("movq %rax, " + this.Off(t));

            return t;

        }

        bool isFlBin = contains(n.left.tyHint, "float") || contains(n.left.tyHint, "double") ||
                       contains(n.tyHint, "float") || contains(n.tyHint, "double") ||
                       (n.left.kind == NK.Var && this.IsFloatTy(this.LocalType(n.left.text))) ||
                       (n.right.kind == NK.Var && this.IsFloatTy(this.LocalType(n.right.text)));

        if (isFlBin) {

            int a2 = this.GenExpr(n.left);

            int b2 = this.GenExpr(n.right);

            int t2 = this.NewTmp();

            bool laF = contains(n.left.tyHint, "float") || contains(n.left.tyHint, "double") || (n.left.kind == NK.Var && this.IsFloatTy(this.LocalType(n.left.text))) || (n.left.kind == NK.Num && contains(n.left.text, "."));
            bool raF = contains(n.right.tyHint, "float") || contains(n.right.tyHint, "double") || (n.right.kind == NK.Var && this.IsFloatTy(this.LocalType(n.right.text))) || (n.right.kind == NK.Num && contains(n.right.text, "."));
            this.Emit("movq " + this.Off(a2) + ", %rax");
            this.Emit("movq " + this.Off(b2) + ", %rcx");
            if (laF) this.Emit("movq %rax, %xmm0");
            else this.Emit("cvtsi2sdq %rax, %xmm0");
            if (raF) this.Emit("movq %rcx, %xmm1");
            else this.Emit("cvtsi2sdq %rcx, %xmm1");

            if (n.op == "==" || n.op == "!=" || n.op == "<" || n.op == ">" ||
                n.op == "<=" || n.op == ">=") {
                this.Emit("ucomisd %xmm1, %xmm0");
                if (n.op == "==") this.Emit("sete %al");
                else if (n.op == "!=") this.Emit("setne %al");
                else if (n.op == "<") this.Emit("setb %al");
                else if (n.op == ">") this.Emit("seta %al");
                else if (n.op == "<=") this.Emit("setbe %al");
                else this.Emit("setae %al");
                this.Emit("movzbl %al, %eax");
                this.Emit("movq %rax, " + this.Off(t2));
                return t2;
            }

            if (n.op == "+") this.Emit("addsd %xmm1, %xmm0");

            else if (n.op == "-") this.Emit("subsd %xmm1, %xmm0");

            else if (n.op == "*") this.Emit("mulsd %xmm1, %xmm0");

            else if (n.op == "/") this.Emit("divsd %xmm1, %xmm0");

            this.Emit("movq %xmm0, %rax");

            this.Emit("movq %rax, " + this.Off(t2));

            return t2;

        }

        if ((n.op == "==" || n.op == "!=") && this.IsRichEnum(n.left.tyHint) && this.IsRichEnum(n.right.tyHint)) {
            int a2 = this.GenExpr(n.left);
            int b2 = this.GenExpr(n.right);
            int tg = this.NewTmp();
            this.Emit("movq " + this.Off(a2) + ", %rax");
            this.Emit("movq (%rax), %rax");
            this.Emit("movq " + this.Off(b2) + ", %rcx");
            this.Emit("movq (%rcx), %rcx");
            this.Emit("cmpq %rcx, %rax");
            if (n.op == "==") this.Emit("sete %al");
            else this.Emit("setne %al");
            this.Emit("movzbl %al, %eax");
            this.Emit("movq %rax, " + this.Off(tg));
            return tg;
        }

        int a = this.GenExpr(n.left);

        int b = this.GenExpr(n.right);

        int t = this.NewTmp();

        this.Emit("movq " + this.Off(a) + ", %rax");

        this.Emit("movq " + this.Off(b) + ", %rcx");

        string op = n.op;

        if (op == "+") this.Emit("addq %rcx, %rax");

        else if (op == "-") this.Emit("subq %rcx, %rax");

        else if (op == "*") this.Emit("imulq %rcx, %rax");

        else if (op == "&") this.Emit("andq %rcx, %rax");

        else if (op == "|") this.Emit("orq %rcx, %rax");

        else if (op == "^") this.Emit("xorq %rcx, %rax");

        else if (op == "<<") this.Emit("shlq %cl, %rax");

        else if (op == ">>") this.Emit("sarq %cl, %rax");

        else if (op == "/") {

            this.Emit("cqto");

            this.Emit("idivq %rcx");

        } else if (op == "%") {

            this.Emit("cqto");

            this.Emit("idivq %rcx");

            this.Emit("movq %rdx, %rax");

        } else {

            // comparaÃƒÂ§ÃƒÂ£o Ã¢â€ â€™ 0/1

            this.Emit("cmpq %rcx, %rax");

            if (op == "==") this.Emit("sete %al");

            else if (op == "!=") this.Emit("setne %al");

            else if (op == "<") this.Emit("setl %al");

            else if (op == ">") this.Emit("setg %al");

            else if (op == "<=") this.Emit("setle %al");

            else this.Emit("setge %al");

            this.Emit("movzbl %al, %eax");

        }

        this.Emit("movq %rax, " + this.Off(t));

        return t;

    }



    int GenAndOr(Node n) {

        // M15-fix: versao correta â€” && curto-circuita em falso (0);

        // || curto-circuita em VERDADEIRO (1) e so fica 0 se ambos falsos

        int t = this.NewTmp();

        string shortL = this.NewLbl("sc");

        if (n.op == "&&") {

            this.Emit("movq $0, %rax");

            this.Emit("movq %rax, " + this.Off(t));

            int a = this.GenExpr(n.left);

            this.Emit("movq " + this.Off(a) + ", %rax");

            this.Emit("testq %rax, %rax");

            this.Emit("je " + shortL);

            int b = this.GenExpr(n.right);

            this.Emit("movq " + this.Off(b) + ", %rax");

            this.Emit("testq %rax, %rax");

            this.Emit("je " + shortL);

            this.Emit("movq $1, %rax");

            this.Emit("movq %rax, " + this.Off(t));

            this.Emit(shortL + ":");

        } else {

            string oneL = this.NewLbl("sct");

            this.Emit("movq $0, %rax");

            this.Emit("movq %rax, " + this.Off(t));

            int a = this.GenExpr(n.left);

            this.Emit("movq " + this.Off(a) + ", %rax");

            this.Emit("testq %rax, %rax");

            this.Emit("jne " + oneL);

            int b = this.GenExpr(n.right);

            this.Emit("movq " + this.Off(b) + ", %rax");

            this.Emit("testq %rax, %rax");

            this.Emit("jne " + oneL);

            this.Emit("jmp " + shortL);

            this.Emit(oneL + ":");

            this.Emit("movq $1, %rax");

            this.Emit("movq %rax, " + this.Off(t));

            this.Emit(shortL + ":");

        }

        return t;

    }



    int GenTask(Node n) {
        Decl taskFn = new Decl();
        taskFn.kind = PK.Fn;
        int taskId = this.taskCounter;
        this.taskCounter = this.taskCounter + 1;
        string fnName = "__task_" + taskId;
        taskFn.name = fnName;
        taskFn.body = n.lamBody;
        taskFn.captures = n.lamCaptures;
        Pm envP = mkParam("ptr", "__env");
        Pm resP = mkParam("ptr", "__res");
        envP.next = resP;
        taskFn.params = envP;
        if (this.lambdaHead == null) {
            this.lambdaHead = taskFn;
            this.lambdaTail = taskFn;
        } else {
            this.lambdaTail.next = taskFn;
            this.lambdaTail = taskFn;
        }
        int nCaps = 0;
        Pm cp = n.lamCaptures;
        while (cp != null) { nCaps = nCaps + 1; cp = cp.next; }
        int envSlot = this.NewTmp();
        if (nCaps > 0) {
            this.Emit("movq $" + (nCaps * 8) + ", %rcx");
            this.Emit("subq $32, %rsp");
            this.Emit("call malloc");
            this.Emit("addq $32, %rsp");
            this.Emit("movq %rax, " + this.Off(envSlot));
            Pm cap = n.lamCaptures;
            int ci = 0;
            while (cap != null) {
                int srcSlot = this.LocalSlot(cap.name);
                if (srcSlot >= 0) {
                    this.Emit("movq " + this.Off(srcSlot) + ", %r10");
                    this.Emit("movq " + this.Off(envSlot) + ", %rax");
                    this.Emit("movq %r10, " + (ci * 8) + "(%rax)");
                }
                ci = ci + 1;
                cap = cap.next;
            }
        } else {
            this.Emit("movq $0, %rax");
            this.Emit("movq %rax, " + this.Off(envSlot));
        }
        int boxSlot = this.NewTmp();
        this.Emit("movq " + this.Off(envSlot) + ", %rdx");
        this.Emit("leaq _sh_" + fnName + "_0(%rip), %rcx");
        this.Emit("subq $32, %rsp");
        this.Emit("call hphl_spawn_task_ex");
        this.Emit("addq $32, %rsp");
        this.Emit("movq %rax, " + this.Off(boxSlot));
        return boxSlot;
    }

    int GenLambda(Node n) {
        Decl lamFn = new Decl();
        lamFn.kind = PK.Fn;
        int lamId = this.lambdaCounter;
        this.lambdaCounter = this.lambdaCounter + 1;
        string fnName = "__lambda_" + lamId;
        n.lamFnLabel = fnName;
        lamFn.name = fnName;
        lamFn.body = n.lamBody;
        lamFn.captures = n.lamCaptures;

        // O 1º parâmetro é sempre env (%rcx)
        Pm envP = mkParam("ptr", "__env");
        envP.next = n.lamParams;
        lamFn.params = envP;

        // Enfileira a função sintética para emissão
        if (this.lambdaHead == null) {
            this.lambdaHead = lamFn;
            this.lambdaTail = lamFn;
        } else {
            this.lambdaTail.next = lamFn;
            this.lambdaTail = lamFn;
        }

        // Conta parâmetros de usuário para a aridade do rótulo
        int userArity = 0;
        Pm up = n.lamParams;
        while (up != null) { userArity = userArity + 1; up = up.next; }

        // 1. Aloca e popula o env box com as capturas por valor
        int nCaps = 0;
        Pm cp = n.lamCaptures;
        while (cp != null) { nCaps = nCaps + 1; cp = cp.next; }

        int envSlot = this.NewTmp();
        if (nCaps > 0) {
            this.Emit("movq $" + (nCaps * 8) + ", %rcx");
            this.Emit("subq $32, %rsp");
            this.Emit("call hphl_shared_alloc");
            this.Emit("addq $32, %rsp");
            this.Emit("movq %rax, " + this.Off(envSlot));

            Pm cap = n.lamCaptures;
            int ci = 0;
            while (cap != null) {
                int srcSlot = this.LocalSlot(cap.name);
                if (srcSlot >= 0) {
                    this.Emit("movq " + this.Off(srcSlot) + ", %r10");
                    this.Emit("movq " + this.Off(envSlot) + ", %rax");
                    this.Emit("movq %r10, " + (ci * 8) + "(%rax)");
                }
                ci = ci + 1;
                cap = cap.next;
            }
        } else {
            this.Emit("movq $0, %rax");
            this.Emit("movq %rax, " + this.Off(envSlot));
        }

        // 2. Aloca o closure box (16 bytes: code_ptr, env_ptr)
        int boxSlot = this.NewTmp();
        this.Emit("movq $16, %rcx");
        this.Emit("subq $32, %rsp");
        this.Emit("call hphl_shared_alloc");
        this.Emit("addq $32, %rsp");
        this.Emit("movq %rax, " + this.Off(boxSlot));

        // code pointer at offset 0
        this.Emit("leaq _sh_" + fnName + "_" + userArity + "(%rip), %r10");
        this.Emit("movq " + this.Off(boxSlot) + ", %rax");
        this.Emit("movq %r10, 0(%rax)");

        // env pointer at offset 8
        this.Emit("movq " + this.Off(envSlot) + ", %r10");
        this.Emit("movq " + this.Off(boxSlot) + ", %rax");
        this.Emit("movq %r10, 8(%rax)");

        // 3. Suporte a recursão (selfName gravado no próprio env)
        if (n.lamSelfName != "") {
            Pm cap = n.lamCaptures;
            int ci = 0;
            while (cap != null) {
                if (cap.name == n.lamSelfName) {
                    this.Emit("movq " + this.Off(boxSlot) + ", %rax");
                    this.Emit("movq " + this.Off(envSlot) + ", %r10");
                    this.Emit("movq %rax, " + (ci * 8) + "(%r10)");
                    break;
                }
                ci = ci + 1;
                cap = cap.next;
            }
        }

        return boxSlot;
    }

    int GenIndirectCall(Node n) {
        int boxSlot = 0;
        if (n.left != null) {
            boxSlot = this.GenExpr(n.left);
        } else {
            boxSlot = this.LocalSlot(n.text);
        }

        int nargs = 0;
        Node ca = n.arg;
        while (ca != null) { nargs = nargs + 1; ca = ca.next; }

        int total = 1 + nargs;
        int stackArgs = 0;
        if (total > 4) stackArgs = total - 4;
        int bytes = (32 + stackArgs * 8 + 15) & -16;

        this.Emit("subq $" + bytes + ", %rsp");

        Node a = n.arg;
        int ai = 0;
        while (a != null) {
            int at = this.GenExpr(a);
            int k = ai + 1;
            bool isFp = this.IsFloatTy(a.tyHint) || (a.kind == NK.Num && contains(a.text, "."));
            this.Emit("movq " + this.Off(at) + ", %rax");
            if (k < 4) {
                this.Emit("movq %rax, " + (8 * k) + "(%rsp)");
            } else {
                this.Emit("movq %rax, " + (32 + 8 * (k - 4)) + "(%rsp)");
            }
            ai = ai + 1;
            a = a.next;
        }

        this.Emit("movq " + this.Off(boxSlot) + ", %rax");
        this.Emit("movq 8(%rax), %rax");
        this.Emit("movq %rax, 0(%rsp)");

        this.Emit("movq " + this.Off(boxSlot) + ", %r10");
        this.Emit("movq 0(%r10), %r10");

        this.Emit("movq 0(%rsp), %rcx");

        string[4] regs;
        regs[0] = "%rcx";
        regs[1] = "%rdx";
        regs[2] = "%r8";
        regs[3] = "%r9";

        a = n.arg;
        ai = 0;
        while (a != null && ai < 3) {
            int k = ai + 1;
            bool isFp = this.IsFloatTy(a.tyHint) || (a.kind == NK.Num && contains(a.text, "."));
            this.Emit("movq " + (8 * k) + "(%rsp), " + regs[k]);
            if (isFp) {
                this.Emit("movsd " + (8 * k) + "(%rsp), %xmm" + k);
            }
            ai = ai + 1;
            a = a.next;
        }

        this.Emit("call *%r10");
        this.Emit("addq $" + bytes + ", %rsp");

        int tr = this.NewTmp();
        this.Emit("movq %rax, " + this.Off(tr));
        return tr;
    }

    int ArrTotal(string ty) {
        int total = 1;
        int n = str_len(ty);
        int i = 0;
        while (i < n) {
            if (sub_str(ty, i, 1) == "[") {
                int j = i + 1;
                string num = "";
                while (j < n && sub_str(ty, j, 1) != "]") {
                    num = num + sub_str(ty, j, 1);
                    j = j + 1;
                }
                if (num != "") {
                    var pv = parse_int(num);
                    total = total * (int)pv;
                }
                i = j;
            }
            i = i + 1;
        }
        return total;
    }

    bool IsArrTy(string ty) {
        if (ty == "" || starts_with(ty, "list") || starts_with(ty, "map")) return false;
        return contains(ty, "[");
    }

    int GenAsyncArg(Node a) {
        string ty = a.tyHint;
        if (ty == "" && a.kind == NK.Var) ty = this.LocalType(a.text);
        if (this.IsArrTy(ty)) {
            int total = this.ArrTotal(ty);
            if (total <= 0) total = 1;
            int baseS = this.GenExpr(a);
            int dataS = this.NewTmp();
            this.Emit("movq $" + (total * 8) + ", %rcx");
            this.Emit("subq $32, %rsp");
            this.Emit("call hphl_shared_alloc");
            this.Emit("addq $32, %rsp");
            this.Emit("movq %rax, " + this.Off(dataS));
            this.Emit("movq " + this.Off(baseS) + ", %rsi");
            this.Emit("movq " + this.Off(dataS) + ", %rdi");
            this.Emit("movq $" + total + ", %rcx");
            this.Emit("pushq %rsi");
            this.Emit("pushq %rdi");
            this.Emit("rep movsq");
            this.Emit("popq %rdi");
            this.Emit("popq %rsi");
            int es = this.NewTmp();
            this.Emit("movq " + this.Off(dataS) + ", %rax");
            this.Emit("movq %rax, " + this.Off(es));
            return es;
        }
        return this.GenExpr(a);
    }

    int GenCall(Node n) {
        if (n.isIndirectCall || n.left != null || (n.recv == null && this.LocalSlot(n.text) >= 0 && starts_with(this.LocalType(n.text), "func"))) {
            return this.GenIndirectCall(n);
        }

        if (n.recv == null && this.IsAsyncFn(n.text)) {
            int nargs = 0;
            Node ca = n.arg;
            while (ca != null) { nargs = nargs + 1; ca = ca.next; }
            int envSlot = this.NewTmp();
            if (nargs > 0) {
                this.Emit("movq $" + (nargs * 8) + ", %rcx");
                this.Emit("subq $32, %rsp");
                this.Emit("call malloc");
                this.Emit("addq $32, %rsp");
                this.Emit("movq %rax, " + this.Off(envSlot));
                Node fa = n.arg;
                int fi = 0;
                while (fa != null) {
                    int at = this.GenExpr(fa);
                    this.Emit("movq " + this.Off(at) + ", %r10");
                    this.Emit("movq " + this.Off(envSlot) + ", %rax");
                    this.Emit("movq %r10, " + (fi * 8) + "(%rax)");
                    fi = fi + 1;
                    fa = fa.next;
                }
            } else {
                this.Emit("movq $0, %rax");
                this.Emit("movq %rax, " + this.Off(envSlot));
            }
            this.Emit("movq " + this.Off(envSlot) + ", %rdx");
            bool foundAsync = false;
            Decl ddw = this.gProg;
            while (ddw != null) {
                if (ddw.kind == PK.Fn && ddw.owner == "" && ddw.name == n.text && ddw.isAsync) {
                    foundAsync = true;
                    break;
                }
                ddw = ddw.next;
            }
            int ac = 0;
            Pm ap = null;
            if (foundAsync) ap = ddw.params;
            while (ap != null) { ac = ac + 1; ap = ap.next; }
            this.Emit("leaq _sh_" + n.text + "_" + ac + "(%rip), %rcx");
            this.Emit("subq $32, %rsp");
            this.Emit("call hphl_spawn_task_ex");
            this.Emit("addq $32, %rsp");
            int tr = this.NewTmp();
            this.Emit("movq %rax, " + this.Off(tr));
            return tr;
        }

        if (n.recv != null) {
            string arTy = n.recv.tyHint;
            if (arTy == "" && n.recv.kind == NK.Var) arTy = this.LocalType(n.recv.text);
            string arBase = arTy;
            var abk = index_of(arTy, "<");
            if (abk > 0) arBase = sub_str(arTy, 0, abk);
            if (this.IsAsyncMethod(arBase, n.text)) {
                int nargs = 0;
                Node ca = n.arg;
                while (ca != null) { nargs = nargs + 1; ca = ca.next; }
                int total = 1 + nargs;
                int envSlot = this.NewTmp();
                this.Emit("movq $" + (total * 8) + ", %rcx");
                this.Emit("subq $32, %rsp");
                this.Emit("call malloc");
                this.Emit("addq $32, %rsp");
                this.Emit("movq %rax, " + this.Off(envSlot));
                int thisS = this.GenExpr(n.recv);
                this.Emit("movq " + this.Off(thisS) + ", %r10");
                this.Emit("movq " + this.Off(envSlot) + ", %rax");
                this.Emit("movq %r10, 0(%rax)");
                Node fa = n.arg;
                int fi = 0;
                while (fa != null) {
                    int at = this.GenAsyncArg(fa);
                    this.Emit("movq " + this.Off(at) + ", %r10");
                    this.Emit("movq " + this.Off(envSlot) + ", %rax");
                    this.Emit("movq %r10, " + ((fi + 1) * 8) + "(%rax)");
                    fi = fi + 1;
                    fa = fa.next;
                }
                this.Emit("movq " + this.Off(envSlot) + ", %rdx");
                int ac = 0;
                Decl ddw = this.gProg;
                while (ddw != null) {
                    if (ddw.kind == PK.Fn && ddw.owner == arBase && ddw.name == n.text) {
                        Pm ap = ddw.params;
                        ac = 0;
                        while (ap != null) { ac = ac + 1; ap = ap.next; }
                        break;
                    }
                    ddw = ddw.next;
                }
                if (ac > 0) ac = ac - 1;
                this.Emit("leaq _sh_" + arBase + "_" + n.text + "_" + ac + "(%rip), %rcx");
                this.Emit("subq $32, %rsp");
                this.Emit("call hphl_spawn_task_ex");
                this.Emit("addq $32, %rsp");
                int tr = this.NewTmp();
                this.Emit("movq %rax, " + this.Off(tr));
                return tr;
            }
        }

        string cen = "";
        string cvn = "";
        if (n.recv != null && n.recv.kind == NK.Member && n.recv.left != null && n.recv.left.kind == NK.Var) {
            cen = n.recv.left.text;
            cvn = n.recv.text;
        } else if (n.recv != null && n.recv.kind == NK.Var) {
            cen = n.recv.text;
            cvn = n.text;
        }
        if (cen != "" && cvn == "FromInt") {
            int fvs = 0;
            if (n.arg != null) fvs = this.GenExpr(n.arg);
            int fcell = this.NewTmp();
            this.Emit("movq $16, %rcx");
            this.Emit("subq $32, %rsp");
            this.Emit("call hphl_shared_alloc");
            this.Emit("addq $32, %rsp");
            this.Emit("movq %rax, " + this.Off(fcell));
            string fSome = this.NewLbl("fromint_some");
            string fEnd = this.NewLbl("fromint_end");
            int fe = -1;
            for (int fi = 0; fi < this.eN; fi++) {
                if (this.eN2[fi] == cen) { fe = fi; break; }
            }
            if (fe >= 0) {
                string vs = this.eV2[fe];
                var blen = str_len(vs);
                int cur = 0;
                int start = 0;
                for (int k = 0; k <= blen; k++) {
                    if (k == blen || sub_str(vs, k, 1) == ",") {
                        string seg = sub_str(vs, start, k - start);
                        string nm = seg;
                        var eq = index_of(seg, "=");
                        if ((int)eq > 0) {
                            string sv = sub_str(seg, (int)eq + 1, str_len(seg) - (int)eq - 1);
                            var pox = index_of(sv, "(");
                            string sv2 = sv;
                            if ((int)pox >= 0) sv2 = sub_str(sv, (int)pox + 1, str_len(sv) - (int)pox - 1);
                            var pv = parse_int(sv2);
                            cur = (int)pv;
                            nm = sub_str(seg, 0, (int)eq);
                        }
                        var po = index_of(nm, "(");
                        if ((int)po > 0) nm = sub_str(nm, 0, (int)po);
                        this.Emit("movq " + this.Off(fvs) + ", %rax");
                        this.Emit("cmpq $" + cur + ", %rax");
                        this.Emit("je " + fSome);
                        cur = cur + 1;
                        start = k + 1;
                    }
                }
            }
            this.Emit("movq $0, %rax");
            this.Emit("movq " + this.Off(fcell) + ", %rcx");
            this.Emit("movq %rax, 0(%rcx)");
            this.Emit("movq " + this.Off(fvs) + ", %rax");
            this.Emit("movq %rax, 8(%rcx)");
            this.Emit("jmp " + fEnd);
            this.Emit(fSome + ":");
            this.Emit("movq $1, %rax");
            this.Emit("movq " + this.Off(fcell) + ", %rcx");
            this.Emit("movq %rax, 0(%rcx)");
            this.Emit("movq " + this.Off(fvs) + ", %rax");
            this.Emit("movq %rax, 8(%rcx)");
            this.Emit(fEnd + ":");
            int trf = this.NewTmp();
            this.Emit("movq " + this.Off(fcell) + ", %rax");
            this.Emit("movq %rax, " + this.Off(trf));
            return trf;
        }
        if (cen != "" && this.IsRichEnum(cen)) {
            int tag = this.EnumValOf(cen, cvn);
            int nargs = 0;
            Node ea = n.arg;
            while (ea != null) { nargs = nargs + 1; ea = ea.next; }
            int bytes = 8 + 8 * nargs;
            int hcell = this.NewTmp();
            this.Emit("movq $" + bytes + ", %rcx");
            this.Emit("subq $32, %rsp");
            this.Emit("call hphl_shared_alloc");
            this.Emit("addq $32, %rsp");
            this.Emit("movq %rax, " + this.Off(hcell));
            this.Emit("movq $" + tag + ", %r10");
            this.Emit("movq " + this.Off(hcell) + ", %rax");
            this.Emit("movq %r10, 0(%rax)");
            Node fa = n.arg;
            int fi = 0;
            while (fa != null) {
                int at = this.GenExpr(fa);
                this.Emit("movq " + this.Off(at) + ", %r10");
                this.Emit("movq " + this.Off(hcell) + ", %rax");
                this.Emit("movq %r10, " + (8 * (fi + 1)) + "(%rax)");
                fi = fi + 1;
                fa = fa.next;
            }
            int trc = this.NewTmp();
            this.Emit("movq " + this.Off(hcell) + ", %rax");
            this.Emit("movq %rax, " + this.Off(trc));
            return trc;
        }

        if (n.recv == null && (n.text == "Some" || n.text == "Ok" || n.text == "Err" || n.text == "None")) {
            int tag = 0;
            if (n.text == "Some" || n.text == "Err") tag = 1;
            int pay = -1;
            if (n.arg != null) pay = this.GenExpr(n.arg);
            int hcell = this.NewTmp();
            this.Emit("movq $16, %rcx");
            this.Emit("subq $32, %rsp");
            this.Emit("call hphl_shared_alloc");
            this.Emit("addq $32, %rsp");
            this.Emit("movq %rax, " + this.Off(hcell));
            this.Emit("movq $" + tag + ", %r10");
            this.Emit("movq " + this.Off(hcell) + ", %rax");
            this.Emit("movq %r10, 0(%rax)");
            if (pay >= 0) {
                this.Emit("movq " + this.Off(pay) + ", %r10");
                this.Emit("movq " + this.Off(hcell) + ", %rax");
                this.Emit("movq %r10, 8(%rax)");
            } else {
                this.Emit("movq $0, %r10");
                this.Emit("movq " + this.Off(hcell) + ", %rax");
                this.Emit("movq %r10, 8(%rax)");
            }
            int trc = this.NewTmp();
            this.Emit("movq " + this.Off(hcell) + ", %rax");
            this.Emit("movq %rax, " + this.Off(trc));
            return trc;
        }

        if (n.recv == null && n.text != "list" && !starts_with(n.text, "list<") &&
            n.text != "map" && !starts_with(n.text, "map<")) {
            string clsName = n.text;
            int actualCountC = 0;
            Node cntNodeC = n.arg;
            while (cntNodeC != null) { actualCountC = actualCountC + 1; cntNodeC = cntNodeC.next; }
            Decl cd = this.FindCtorDecl(clsName, actualCountC);
            if (cd == null) cd = null;
            if (cd != null || this.hasCtor(clsName, 0)) {
            int cnt = this.CntOf(clsName);
            if (cnt < 0) cnt = 4;
            Pm cp = (cd != null && cd.params != null) ? cd.params.next : null;

            int bytes = (cnt + 64) * 8;
            if (bytes < 64) bytes = 64;
            int t = this.NewTmp();
            this.Emit("movq $" + bytes + ", %rcx");
            this.Emit("subq $32, %rsp");
            this.Emit("call hphl_shared_alloc");
            this.Emit("addq $32, %rsp");
            this.Emit("pushq %rdi");
            this.Emit("pushq %rax");
            this.Emit("movq %rax, %rdi");
            this.Emit("movq $" + bytes + ", %rcx");
            this.Emit("xorl %eax, %eax");
            this.Emit("rep stosb");
            this.Emit("popq %rax");
            this.Emit("popq %rdi");

            this.Emit("movq %rax, " + this.Off(t));
            this.gRoots[this.gRootN] = t;
            this.gRootN = this.gRootN + 1;

            int[16] cargs;
            Node ca = n.arg;
            int cn = 0;
            while (ca != null && cn < 15) {
                bool byRef = ca.refKind != "";
                if (!byRef && cp != null) {
                    if (cp.refKind == "ref" || cp.refKind == "out" || cp.refKind == "in") byRef = true;
                }
                if (byRef) {
                    cargs[cn] = this.AddrOf(ca);
                } else {
                    cargs[cn] = this.GenExpr(ca);
                }
                if (cp != null) cp = cp.next;
                cn = cn + 1;
                ca = ca.next;
            }

            while (cp != null && cn < 15) {
                if (cp.defVal != null) {
                    cargs[cn] = this.GenExpr(cp.defVal);
                    cn = cn + 1;
                }
                cp = cp.next;
            }

            int totalC = 1 + cn;
            int stkC = 0;
            if (totalC > 4) stkC = totalC - 4;
            int bytesC = (32 + stkC * 8 + 15) & -16;
            this.Emit("subq $" + bytesC + ", %rsp");

            this.Emit("movq " + this.Off(t) + ", %rax");
            this.Emit("movq %rax, %rcx");
            if (cn > 0) this.Emit("movq " + this.Off(cargs[0]) + ", %rdx");
            if (cn > 1) this.Emit("movq " + this.Off(cargs[1]) + ", %r8");
            if (cn > 2) this.Emit("movq " + this.Off(cargs[2]) + ", %r9");
            int sci = 3;
            while (sci < cn) {
                int k = sci + 1;
                this.Emit("movq " + this.Off(cargs[sci]) + ", %rax");
                this.Emit("movq %rax, " + (32 + 8 * (k - 4)) + "(%rsp)");
                sci = sci + 1;
            }

            this.Emit("call _sh_" + clsName + "_" + clsName + "_" + cn);
            this.Emit("addq $" + bytesC + ", %rsp");

            int trcc = this.NewTmp();
            this.Emit("movq " + this.Off(t) + ", %rax");
            this.Emit("movq %rax, " + this.Off(trcc));
            return trcc;
            }
        }

        if (n.recv == null && (n.text == "SizeOf" || n.text == "FieldCount" ||
            n.text == "HasField" || n.text == "FieldOffset")) {
            string cls = "";
            if (n.arg != null && n.arg.kind == NK.Var) cls = n.arg.text;
            int ci = -1;
            for (int qi = 0; qi < this.cN2; qi++) {
                if (this.cNames[qi] == cls) { ci = qi; break; }
            }
            if (ci < 0) {
                var blt = index_of(cls, "<");
                if (blt > 0) {
                    string cb2 = sub_str(cls, 0, blt);
                    for (int qi = 0; qi < this.cN2; qi++) {
                        if (this.cNames[qi] == cb2) { ci = qi; break; }
                    }
                }
            }
            int val = 0;
            if (n.text == "SizeOf") {
                if (ci >= 0 && !this.cIsClass[ci]) {
                    val = this.cCnt[ci] * 8;
                    if (val < 8) val = 8;
                } else if (ci >= 0) {
                    val = (this.cCnt[ci] + 1) * 8;
                }
            } else if (n.text == "FieldCount") {
                val = 0;
                if (ci >= 0) {
                    val = this.cCnt[ci];
                    string bb = this.cBase[ci];
                    while (bb != "") {
                        int bi = -1;
                        for (int qi = 0; qi < this.cN2; qi++) {
                            if (this.cNames[qi] == bb) { bi = qi; break; }
                        }
                        if (bi < 0) break;
                        val = val - this.cCnt[bi];
                        bb = this.cBase[bi];
                    }
                }
            } else {
                string fname = "";
                if (n.arg != null && n.arg.next != null && n.arg.next.kind == NK.Str) fname = this.StripQuotes(n.arg.next.text);
                int off = -1;
                if (ci >= 0 && fname != "") off = this.FldOff(this.cNames[ci], fname);
                if (n.text == "HasField") val = off >= 0 ? 1 : 0;
                else val = off;
            }
            int trm = this.NewTmp();
            this.Emit("movq $" + val + ", %rax");
            this.Emit("movq %rax, " + this.Off(trm));
            return trm;
        }

        // builtins

        if (n.recv != null) {

            string recvTy = n.recv.tyHint;
            if (recvTy == "" && n.recv.kind == NK.Var) recvTy = this.LocalType(n.recv.text);

            if (recvTy == "list" || starts_with(recvTy, "list<") || (n.text == "Add" && this.FindMethodDecl(recvTy, n.text, 1) == null)) {
                if (n.text == "Add") {
                    int rT = this.GenExpr(n.recv);
                    int vT = this.GenExpr(n.arg);
                    this.Emit("movq " + this.Off(rT) + ", %rcx");
                    bool isFl = contains(recvTy, "<float") || contains(recvTy, "<double") || n.arg.tyHint == "float" || (n.arg.kind == NK.Num && contains(n.arg.text, "."));
                    if (isFl) {
                        this.Emit("movq " + this.Off(vT) + ", %rax");
