            if (recvTy == "map" || starts_with(recvTy, "map<") || ((n.text == "Put" || n.text == "Get" || n.text == "Contains" || n.text == "Remove" || n.text == "Clear") && this.FindMethodDecl(recvTy, n.text, 1) == null)) {
                if (n.text == "Put") {
                    int rT = this.GenExpr(n.recv);
                    int kT = this.GenExpr(n.arg);
                    int vT = this.GenExpr(n.arg.next);
                    this.Emit("movq " + this.Off(rT) + ", %rcx");
                    this.Emit("movq " + this.Off(kT) + ", %rdx");
                    this.Emit("movq " + this.Off(vT) + ", %r8");
