        this.curOwner = d.owner;

        int userArity = 0;
        Pm apm = d.params;
        while (apm != null) { userArity = userArity + 1; apm = apm.next; }
        if (d.owner != "") userArity = userArity - 1;
        if (starts_with(d.name, "__lambda_")) userArity = userArity - 1;
        if (starts_with(d.name, "__task_")) userArity = userArity - 2;
        this.curIsTask = starts_with(d.name, "__task_") || d.isAsync;

        bool isMain = d.name == "Main";

        string lbl2 = isMain ? "main" : (d.owner != "" ? "_sh_" + d.owner + "_" + d.name + "_" + userArity : "_sh_" + d.name + "_" + userArity);

        this.fnRetLbl = ".Lret_" + d.name + "_" + this.ln; // M15-fix7: unico entre classes

        // parâmetros → slots (Win64: rcx, rdx, r8, r9) — no buffer PRÓPRIO
        // (pLines), emitido antes dos gc_add_root: calls clobberam params.

        Pm pm = d.params;
        string[4] preg;

        preg[0] = "%rcx";

        preg[1] = "%rdx";

        preg[2] = "%r8";

        preg[3] = "%r9";

        int pi = 0;

        this.inParam = 1;

        if (d.isAsync) {
            int envSl = this.NewTmp();
