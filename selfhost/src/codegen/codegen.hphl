        string lTy = n.left.tyHint != "" ? n.left.tyHint : n.right.tyHint;

        bool nullCmp1 = n.left.tyHint == "null" || n.right.tyHint == "null";
        if ((n.op == "==" || n.op == "!=") && lTy != "" && lTy != "string" && !nullCmp1 && !this.IsInterface(lTy) && this.CntOf(lTy) >= 0) {

            int a = this.GenExpr(n.left);

            int b = this.GenExpr(n.right);

            int t = this.NewTmp();

            this.Emit("movq " + this.Off(a) + ", %rcx");

            this.Emit("movq " + this.Off(b) + ", %rdx");

            this.Emit("subq $32, %rsp");

