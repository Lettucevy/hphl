                    this.Emit("addq $32, %rsp");

                }

                marg = marg.next;

            }

            if (n.text == "println") {

                this.Emit("movq $10, %rcx");

                this.Emit("subq $32, %rsp");

                this.Emit("call putchar");

                this.Emit("addq $32, %rsp");

            }

            int tv = this.NewTmp();

            this.Emit("movq $0, %rax");

            this.Emit("movq %rax, " + this.Off(tv));

            return tv;

        }



        int[16] t;

        Node a = n.arg;

        int i = 0;

        int actualCount = 0;
        Node cntNode = n.arg;
        while (cntNode != null) { actualCount = actualCount + 1; cntNode = cntNode.next; }
        Decl calleeDecl = (n.recv == null) ? this.FindFnDecl(n.text, actualCount) : null;
        Pm calleeParam = (calleeDecl != null) ? calleeDecl.params : null;

        while (a != null && i < 16) {

            bool byRef = a.refKind != "";
            if (!byRef && calleeParam != null) {
                if (calleeParam.refKind == "ref" || calleeParam.refKind == "out" || calleeParam.refKind == "in") {
                    byRef = true;
                }
            }

            if (byRef) {
                t[i] = this.AddrOf(a);
            } else {
                t[i] = this.GenExpr(a);

                if (a.tyHint != "" && this.IsStruct(a.tyHint)) {
                    int scSlot = this.NewTmp();
                    int bsz = this.CntOf(a.tyHint) * 8;
                    this.Emit("movq " + this.Off(t[i]) + ", %rcx");
                    this.Emit("movq $" + bsz + ", %rdx");
                    this.Emit("subq $32, %rsp");
                    this.Emit("call hphl_struct_copy");
                    this.Emit("addq $32, %rsp");
                    this.Emit("movq %rax, " + this.Off(scSlot));
                    t[i] = scSlot;
                }
            }

            if (calleeParam != null) calleeParam = calleeParam.next;

            i = i + 1;

            a = a.next;

        }

        while (calleeParam != null && i < 16) {
            if (calleeParam.defVal != null) {
                t[i] = this.GenExpr(calleeParam.defVal);
                i = i + 1;
            }
            calleeParam = calleeParam.next;
        }

        int stkF = 0;
        if (i > 4) stkF = i - 4;
        int bytesF = (32 + stkF * 8 + 15) & -16;

        this.Emit("subq $" + bytesF + ", %rsp");

        if (i > 0) this.Emit("movq " + this.Off(t[0]) + ", %rcx");

        if (i > 1) this.Emit("movq " + this.Off(t[1]) + ", %rdx");

        if (i > 2) this.Emit("movq " + this.Off(t[2]) + ", %r8");

        if (i > 3) this.Emit("movq " + this.Off(t[3]) + ", %r9");

        int sfi = 4;
        while (sfi < i) {
            this.Emit("movq " + this.Off(t[sfi]) + ", %rax");
            this.Emit("movq %rax, " + (32 + 8 * (sfi - 4)) + "(%rsp)");
            sfi = sfi + 1;
        }

        // M23.1 2.3: monomorfização — usa nome mangled se generics
        string callName = n.text;
        if (n.genArgsC > 0) {
            int gi = 0;
            while (gi < n.genArgsC) { this._cgaArgs[gi] = n.genArgs[gi]; gi = gi + 1; }
            string m = this.instGet(n.text, n.genArgsC);
            if (m != "") callName = m;
        }
        this.Emit("call _sh_" + callName + "_" + i);

        this.Emit("addq $" + bytesF + ", %rsp");

        int tr = this.NewTmp();

        this.Emit("movq %rax, " + this.Off(tr));

        return tr;

    }



    // ------------------------------------------------------------------

    // statements

    // ------------------------------------------------------------------

    void GenStmt(Stmt s) {

        if (s == null) return;

        if (s.kind == SK.VarDecl && s.isArray) {

            // M15.2.3: array LOCAL â€” N slots contÃ­guos na frame, zerados

            int baseS = this.NewTmp();

            this.nextSlot = this.nextSlot + s.arrSize - 1;

            this.lNames[this.lN] = s.text;

            this.lSlots[this.lN] = baseS;

            this.lSizes[this.lN] = s.arrSize;

            this.lTypes[this.lN] = s.name + "[]";

            this.lRefKinds[this.lN] = "";

            this.lN = this.lN + 1;

            // M15-fix: preserva rdi (callee-saved no Win64)

            this.Emit("pushq %rdi");

            // Item 3 Fase 3: slots descem a partir da base; o endereÃ§o-base
            // (menor) Ã© baseS + arrSize - 1, e a contagem do stosq Ã© em
            // QWORDS (arrSize), nÃ£o bytes (arrSize*8 zerava 8x alÃ©m da conta
            // e corrompia a frame â†’ crash no ret).
            this.Emit("leaq " + this.Off(baseS + s.arrSize - 1) + ", %rdi");

            this.Emit("xorl %eax, %eax");

            this.Emit("movq $" + s.arrSize + ", %rcx");

            this.Emit("rep stosq");

            this.Emit("popq %rdi");

            if (s.expr != null) {
                if (s.expr.kind == NK.ArrayInit) {
                    this.arrCsv = s.expr.text;
                    this.GenArrFill(baseS, s.arrSize);
                } else {
                    int srcSlot = this.GenExpr(s.expr);
                    this.Emit("movq " + this.Off(srcSlot) + ", %rcx");
                    this.Emit("leaq " + this.Off(baseS + s.arrSize - 1) + ", %rdx");
                    this.Emit("movq $" + s.arrSize + ", %r8");
                    string lAcp = this.NewLbl("acp");
                    this.Emit(lAcp + ":");
                    this.Emit("movq (%rcx), %r10");
                    this.Emit("addq $8, %rcx");
                    this.Emit("movq %r10, (%rdx)");
                    this.Emit("addq $8, %rdx");
                    this.Emit("decq %r8");
                    this.Emit("jne " + lAcp);
                }
            }

            return;

        }

        if (s.kind == SK.TupleDestruct) {
            int tupSlot = this.GenExpr(s.expr);
            var slen = str_len(s.text);
            int start = 0;
            int idx = 0;
            for (int k = 0; k <= slen; k++) {
                if (k == slen || sub_str(s.text, k, 1) == ",") {
                    string seg = sub_str(s.text, start, k - start);
                    int sn = str_len(seg);
                    int sa = 0;
                    while (sa < sn && sub_str(seg, sa, 1) == " ") sa = sa + 1;
                    int sb = sn;
                    while (sb > sa && sub_str(seg, sb - 1, 1) == " ") sb = sb - 1;
                    string vname = sub_str(seg, sa, sb - sa);
                    int slot = this.LocalSlot(vname);
                    if (slot < 0) {
                        slot = this.NewTmp();
                        this.lNames[this.lN] = vname;
                        this.lSlots[this.lN] = slot;
                        this.lSizes[this.lN] = 0;
                        this.lTypes[this.lN] = "int";
                        this.lRefKinds[this.lN] = "";
                        this.lN = this.lN + 1;
                    }
                    this.Emit("movq " + this.Off(tupSlot) + ", %r10");
                    this.Emit("movq " + (idx * 8) + "(%r10), %rax");
                    this.Emit("movq %rax, " + this.Off(slot));
                    idx = idx + 1;
                    start = k + 1;
                }
            }
            return;
        }

        if (s.kind == SK.VarDecl) {

            int sl = this.NewTmp(); // novo slot para o local

            this.lNames[this.lN] = s.text;

            this.lSlots[this.lN] = sl;

            this.lSizes[this.lN] = 0;

            this.lTypes[this.lN] = s.fullTy != "" ? s.fullTy : s.name;

            this.lRefKinds[this.lN] = "";

            this.lAtomic[this.lN] = s.isAtomic;

            this.lN = this.lN + 1;

            if (s.expr != null) {

                int v = this.GenExpr(s.expr);

                this.Emit("movq " + this.Off(v) + ", %rax");

                string polTy2 = s.fullTy != "" ? s.fullTy : s.name;
                if (this.HasPolicy(polTy2)) {
                    this.EmitPolicy(polTy2);
                }

                this.Emit("movq %rax, " + this.Off(sl));

            } else {

                string tyNm = s.name;
                string ft = s.fullTy;

                if (tyNm == "list" || starts_with(tyNm, "list<") || ft == "list" || starts_with(ft, "list<")) {
                    this.Emit("subq $32, %rsp");
                    this.Emit("call hphl_list_new");
                    this.Emit("addq $32, %rsp");
                    this.Emit("movq %rax, " + this.Off(sl));
                    this.gRoots[this.gRootN] = sl;
                    this.gRootN = this.gRootN + 1;
                    return;
                }
                if (tyNm == "map" || starts_with(tyNm, "map<") || ft == "map" || starts_with(ft, "map<")) {
                    int kKind = 0;
                    if (contains(ft, "<string") || contains(tyNm, "<string")) kKind = 1;
                    else if (contains(ft, "<bool") || contains(tyNm, "<bool")) kKind = 2;
                    else if (contains(ft, "<char") || contains(tyNm, "<char")) kKind = 3;
                    this.Emit("movq $" + kKind + ", %rcx");
                    this.Emit("subq $32, %rsp");
                    this.Emit("call hphl_map_new");
                    this.Emit("addq $32, %rsp");
                    this.Emit("movq %rax, " + this.Off(sl));
                    this.gRoots[this.gRootN] = sl;
                    this.gRootN = this.gRootN + 1;
                    return;
                }

                if (this.IsInterface(tyNm) || this.IsInterface(ft)) {
                    this.Emit("movq $0, %rax");
                    this.Emit("movq %rax, " + this.Off(sl));
                    return;
                }
                string primK = tyNm;
                if (primK == "" || (!this.IsPrimTy(primK) && this.IsPrimTy(ft))) primK = ft;
                if (this.IsPrimTy(primK)) {
                    string hf = "hphl_mutex_new";
                    if (primK == "event") hf = "hphl_event_new";
                    else if (primK == "semaphore") hf = "hphl_semaphore_new";
                    else if (primK == "barrier") hf = "hphl_barrier_new";
                    if (primK == "semaphore" || primK == "barrier") {
                        this.Emit("movq $1, %rcx");
                    }
                    this.Emit("subq $32, %rsp");
                    this.Emit("call " + hf);
                    this.Emit("addq $32, %rsp");
                    this.Emit("movq %rax, " + this.Off(sl));
                    this.gRoots[this.gRootN] = sl;
                    this.gRootN = this.gRootN + 1;
                    return;
                }

                if (s.genArgsC > 0) {

                    int gi = 0;

                    while (gi < s.genArgsC) { this._cgaArgs[gi] = s.genArgs[gi]; gi = gi + 1; }

                    string m = this.instGet(s.name, s.genArgsC);

                    if (m != "") tyNm = m;

                }

                int cnt = this.CntOf(tyNm);

                if (cnt < 0 && s.fullTy != "") cnt = this.CntOf(s.fullTy);

                if (cnt >= 0) {

                    int bytes = (cnt + 64) * 8;

                    if (bytes < 64) bytes = 64;

                    this.Emit("movq $" + bytes + ", %rcx");

                    this.Emit("subq $32, %rsp");

                    this.Emit("call hphl_shared_alloc");

                    this.Emit("addq $32, %rsp");

                    this.Emit("pushq %rdi");

                    this.Emit("pushq %rax");

                    this.Emit("movq %rax, %rdi");

                    this.Emit("movq $" + bytes + ", %rcx");

                    this.Emit("xorl %eax, %eax");

                    this.Emit("rep stosb");

                    this.Emit("popq %rax");

                    this.Emit("popq %rdi");

                    if (this.IsClass(tyNm) && this.vsN > 0) {
                        this.Emit("leaq .Lvt_" + tyNm + "(%rip), %r10");
                        this.Emit("movq %r10, (%rax)");
                    }

