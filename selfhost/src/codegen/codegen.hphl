                int c0 = this.GenExpr(n.left);

                int t0 = this.NewTmp();

                this.Emit("movq " + this.Off(c0) + ", %rax");

                this.Emit("notq %rax");

                this.Emit("movq %rax, " + this.Off(t0));

                return t0;

