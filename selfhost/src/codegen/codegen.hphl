    int GenMatch(Node n) {
        int subjS = this.GenExpr(n.left);
        string subjT = n.left.tyHint;
        if (n.left.kind == NK.Var && subjT != "" && contains(subjT, "[") && !starts_with(subjT, "list")) {
            if (this.GlobalIdx(n.left.text) >= 0) {
                int bs = this.NewTmp();
                this.Emit("leaq .Lg_" + n.left.text + "(%rip), %rax");
                this.Emit("movq %rax, " + this.Off(bs));
                subjS = bs;
            }
        }
        string doneL = this.NewLbl("match_done");
        int resT = this.NewTmp();
        this.Emit("movq $0, %rax");
        this.Emit("movq %rax, " + this.Off(resT));
        Node a = n.arg;
        while (a != null) {
            string nextL = this.NewLbl("match_next");
            this.GenMatchPat(a.left, subjS, subjT, nextL);
            if (a.right != null) {
                int gs = this.GenExpr(a.right);
                this.Emit("movq " + this.Off(gs) + ", %rax");
                this.Emit("cmpq $0, %rax");
                this.Emit("je " + nextL);
            }
            if (a.arg != null) {
                int ys = this.GenExpr(a.arg);
                this.Emit("movq " + this.Off(ys) + ", %rax");
                this.Emit("movq %rax, " + this.Off(resT));
            } else if (a.lamBody != null) {
                this.GenStmt(a.lamBody);
            }
            this.Emit("jmp " + doneL);
            this.Emit(nextL + ":");
            a = a.next;
        }
        this.Emit("movq $0, %rcx");
        this.Emit("subq $32, %rsp");
        this.Emit("call hphl_match_fail");
        this.Emit("addq $32, %rsp");
        this.Emit(doneL + ":");
        return resT;
    }

    int GenExpr(Node n) {
        if (n.kind == NK.Lambda) {
            return this.GenLambda(n);
        }
        if (n.kind == NK.Match) {
            return this.GenMatch(n);
        }
        if (n.kind == NK.Task) {
            return this.GenTask(n);
        }
        if (n.kind == NK.Await) {
            string ot = n.left.tyHint;
            if (ot == "" && n.left.kind == NK.Var) ot = this.LocalType(n.left.text);
            if (ot == "task" || starts_with(ot, "task<")) {
                int bs = this.GenExpr(n.left);
                this.Emit("movq " + this.Off(bs) + ", %rcx");
                this.Emit("subq $32, %rsp");
                this.Emit("call hphl_wait_task");
                this.Emit("addq $32, %rsp");
