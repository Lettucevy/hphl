                this.Emit("movq " + this.Off(vb) + ", %rax");
                this.Emit("movq %rax, " + this.Off(t));
                this.Emit(lEnd + ":");
                return t;
            }
            int t = this.NewTmp();
            int c = this.GenExpr(n.left);
            this.Emit("movq " + this.Off(c) + ", %rax");
            string lElse = this.NewLbl("ce");
            string lEnd = this.NewLbl("cx");
            this.Emit("testq %rax, %rax");
            this.Emit("jz " + lElse);
            this.Emit("movq " + this.Off(c) + ", %rax");
            this.Emit("movq %rax, " + this.Off(t));
            this.Emit("jmp " + lEnd);
            this.Emit(lElse + ":");
            int vb = this.GenExpr(n.right);
            this.Emit("movq " + this.Off(vb) + ", %rax");
            this.Emit("movq %rax, " + this.Off(t));
            this.Emit(lEnd + ":");
            return t;
