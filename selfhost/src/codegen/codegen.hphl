                string lElse = this.NewLbl("ce");
                string lEnd = this.NewLbl("cx");
                this.Emit("cmpq $0, %rax");
                this.Emit("je " + lElse);
                this.Emit("movq " + this.Off(c) + ", %rax");
                this.Emit("movq 8(%rax), %rax");
