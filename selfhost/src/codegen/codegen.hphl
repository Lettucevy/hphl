            this.Emit("subq $32, %rsp");

            this.Emit("call hphl_read_file");

            this.Emit("addq $32, %rsp");

            int trr = this.NewTmp();

            this.Emit("movq %rax, " + this.Off(trr));

            return trr;

        }

        if (n.recv == null && (n.text == "write_file" || n.text == "append_file")) {

            string hf = "hphl_write_file";

            if (n.text == "append_file") hf = "hphl_append_file";

            int[2] tw;

            Node aw = n.arg;

            int iw = 0;

            while (aw != null && iw < 2) { tw[iw] = this.GenExpr(aw); iw = iw + 1; aw = aw.next; }

            this.Emit("movq " + this.Off(tw[0]) + ", %rcx");

            this.Emit("movq " + this.Off(tw[1]) + ", %rdx");

            this.Emit("subq $32, %rsp");

            this.Emit("call " + hf);

            this.Emit("addq $32, %rsp");

            int trw = this.NewTmp();

            this.Emit("movq %rax, " + this.Off(trw));

            return trw;

        }

        if (n.recv == null && n.text == "hphl_gas_str") {
            int ag = this.GenExpr(n.arg);
            this.Emit("movq " + this.Off(ag) + ", %rcx");
            this.Emit("subq $32, %rsp");
            this.Emit("call hphl_gas_str");
            this.Emit("addq $32, %rsp");
            int trg = this.NewTmp();
            this.Emit("movq %rax, " + this.Off(trg));
            return trg;
        }
        if (n.recv == null && n.text == "panic") {

            int a4 = this.GenExpr(n.arg);

            this.Emit("movq " + this.Off(a4) + ", %rcx");

            this.Emit("subq $32, %rsp");

            this.Emit("call hphl_panic");

            this.Emit("addq $32, %rsp");

            int tr4 = this.NewTmp();

            this.Emit("movq $0, %rax");

            this.Emit("movq %rax, " + this.Off(tr4));

