            bool isF = (n.arg != null && (n.arg.tyHint == "float" || n.arg.tyHint == "double" || contains(n.arg.tyHint, "float"))) ||
                       (n.arg.next != null && (n.arg.next.tyHint == "float" || n.arg.next.tyHint == "double" || contains(n.arg.next.tyHint, "float")));
            if (isF) {
                this.Emit("movq " + this.Off(tmm[0]) + ", %rax");
                this.Emit("movq %rax, %xmm0");
                this.Emit("movq " + this.Off(tmm[1]) + ", %rcx");
                this.Emit("movq %rcx, %xmm1");
                this.Emit("subq $32, %rsp");
                if (n.text == "min") this.Emit("call fmin");
                else this.Emit("call fmax");
                this.Emit("addq $32, %rsp");
                this.Emit("movq %xmm0, %rax");
            } else {
                this.Emit("movq " + this.Off(tmm[0]) + ", %rcx");
                this.Emit("movq " + this.Off(tmm[1]) + ", %rdx");
                this.Emit("subq $32, %rsp");
