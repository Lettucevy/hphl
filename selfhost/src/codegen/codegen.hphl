            this.Emit("movq %rax, " + this.Off(envSl));
            int resSl = this.NewTmp();
            this.lNames[this.lN] = "__res";
            this.lSlots[this.lN] = resSl;
            this.lSizes[this.lN] = 0;
            this.lTypes[this.lN] = "ptr";
            this.lRefKinds[this.lN] = "";
            this.lN = this.lN + 1;
            this.Emit("movq %rdx, %rax");
            this.Emit("movq %rax, " + this.Off(resSl));
            int eoff = 0;
            if (d.owner != "") {
                int tsl = this.NewTmp();
                this.lNames[this.lN] = "this";
                this.lSlots[this.lN] = tsl;
                this.lSizes[this.lN] = 0;
                this.lTypes[this.lN] = d.owner;
                this.lRefKinds[this.lN] = "";
                this.lN = this.lN + 1;
                this.Emit("movq " + this.Off(envSl) + ", %rax");
                this.Emit("movq 0(%rax), %r10");
                this.Emit("movq %r10, " + this.Off(tsl));
                eoff = 1;
                pm = pm.next;
            }
            while (pm != null) {
                int sl = this.NewTmp();
                this.lNames[this.lN] = pm.name;
                this.lSlots[this.lN] = sl;
                this.lSizes[this.lN] = this.ArrTypeSize(pm.type);
                this.lIsPtr[this.lN] = this.ArrTypeSize(pm.type) > 0;
                this.lTypes[this.lN] = pm.type;
                this.lRefKinds[this.lN] = pm.refKind;
                this.lN = this.lN + 1;
                this.Emit("movq " + this.Off(envSl) + ", %rax");
                this.Emit("movq " + (eoff * 8) + "(%rax), %r10");
                this.Emit("movq %r10, " + this.Off(sl));
                eoff = eoff + 1;
                pm = pm.next;
            }
        }

        while (pm != null) {

            int sl = this.NewTmp();

            this.lNames[this.lN] = pm.name;

            this.lSlots[this.lN] = sl;

            this.lSizes[this.lN] = this.ArrTypeSize(pm.type);

            this.lIsPtr[this.lN] = this.ArrTypeSize(pm.type) > 0;

            this.lTypes[this.lN] = pm.type;

            this.lRefKinds[this.lN] = pm.refKind;

            this.lN = this.lN + 1;

            if (pi < 4) {
                this.Emit("movq " + preg[pi] + ", %rax");
                this.Emit("movq %rax, " + this.Off(sl));
            } else {
                // Win64 stack arg: caller fez sub bytes + call; no callee
                // (apos push %rbp) o k-esimo arg (k=pi) esta em 48+8*(k-4)(%rbp)
                // (8 saved rbp + 8 ret + 32 shadow). Vale p/ fn normal e lambda
                // (env conta como pi=0, igual ao ref genHirIndirectCall/GenFn).
                this.Emit("movq " + (48 + 8 * (pi - 4)) + "(%rbp), %rax");
                this.Emit("movq %rax, " + this.Off(sl));
            }

            pi = pi + 1;

            pm = pm.next;

        }

        this.inParam = 0;

        if ((starts_with(d.name, "__lambda_") || starts_with(d.name, "__task_")) && d.captures != null) {
            Pm cap = d.captures;
            int ci = 0;
            while (cap != null) {
                // Guarda anti-sombra: se a captura tem o mesmo nome de um
                // parametro, o param deve vencer (LocalSlot acha o ultimo).
                // Ignora a captura para nao sobrescrever o param no lookup.
                bool dup = false;
                Pm pp = d.params;
                while (pp != null) {
                    if (pp.name == cap.name) dup = true;
                    pp = pp.next;
                }
                if (dup) {
                    ci = ci + 1;
                    cap = cap.next;
                    continue;
                }
                int csl = this.NewTmp();
                this.lNames[this.lN] = cap.name;
                this.lSlots[this.lN] = csl;
                this.lSizes[this.lN] = 0;
                this.lTypes[this.lN] = cap.type;
                this.lRefKinds[this.lN] = "";
                this.lN = this.lN + 1;
                this.Emit("movq " + this.Off(12) + ", %rax");
                this.Emit("movq " + (ci * 8) + "(%rax), %r10");
                this.Emit("movq %r10, " + this.Off(csl));
                ci = ci + 1;
                cap = cap.next;
            }
        }

            if (isMain && this.gProg != null) {
                if (this.tlsBytes > 0) {
                    this.Emit("movq $" + this.tlsBytes + ", %rcx");
                    this.Emit("subq $32, %rsp");
                    this.Emit("call hphl_tls_setup");
                    this.Emit("addq $32, %rsp");
                }
                Decl gd = this.gProg;
                while (gd != null) {
                    if (gd.kind == PK.GVar && gd.init == null) {
                        if (gd.retType == "list" || starts_with(gd.retType, "list<")) {
                            this.Emit("subq $32, %rsp");
                            this.Emit("call hphl_list_new");
                            this.Emit("addq $32, %rsp");
                            this.Emit("movq %rax, .Lg_" + gd.name + "(%rip)");
                        } else if (gd.retType == "map" || starts_with(gd.retType, "map<")) {
                            int kKind = 0;
                            if (contains(gd.retType, "<string")) kKind = 1;
                            else if (contains(gd.retType, "<bool")) kKind = 2;
                            else if (contains(gd.retType, "<char")) kKind = 3;
                            this.Emit("movq $" + kKind + ", %rcx");
                            this.Emit("subq $32, %rsp");
                            this.Emit("call hphl_map_new");
                            this.Emit("addq $32, %rsp");
                            this.Emit("movq %rax, .Lg_" + gd.name + "(%rip)");
                        }
                    } else if (gd.kind == PK.GVar && gd.init != null) {
                        bool lit = gd.init.kind == NK.Num;
                        if (!lit && gd.init.kind == NK.Un && gd.init.left != null &&
                            gd.init.left.kind == NK.Num) lit = true;
                        if (!lit) {
                            int gv = this.GenExpr(gd.init);
                            this.Emit("movq " + this.Off(gv) + ", %rax");
                            this.Emit("movq %rax, .Lg_" + gd.name + "(%rip)");
                        }
                    } else if (gd.kind == PK.GVarArray && gd.init != null &&
                               gd.init.kind == NK.ArrayInit) {
                        this.arrCsv = gd.init.text;
                        this.arrG = gd.name;
                        this.GenGArrFill();
                    }
                    gd = gd.next;
                }
            }

            this.GenStmt(d.body);

        // retorno implÃ­cito

        this.Emit("movq $0, %rax");

        // Item 3 Fase 3: reserva slot p/ preservar %rax no epÃ­logo (as calls
        // de remove_root/hphl_gc clobberam rax; sem isso, toda funÃ§Ã£o que
        // retorna valor E tem roots devolvia lixo). Alocado aqui para entrar
        // no cÃ¡lculo da frame abaixo.
        int retSlot = this.NewTmp();

        this.inBody = 0;

        // prÃ³logo com frame FINAL (slots conhecidos) + alinhamento 16

        this.Emit(".text");

        this.Emit(".globl " + lbl2);

        this.Emit(lbl2 + ":");

        this.Emit("pushq %rbp");

        this.Emit("movq %rsp, %rbp");

        int frame = (((this.nextSlot * 8) + 32 + 15) / 16) * 16; // M15-fix4: sem bitwise (portavel self/nativo)

        if (frame > 4096) {
            int p = 4096;
            while (p < frame) {
                this.Emit("movq $0, -" + p + "(%rsp)");
                p = p + 4096;
            }
            this.Emit("movq $0, -" + frame + "(%rsp)");
        }

        this.Emit("subq $" + frame + ", %rsp");

        // Item 3 Fase 3: spills de parÃ¢metros ANTES dos gc_add_root (calls
        // clobberam rcx/rdx/r8/r9 â€” salvar depois perdia this/args).
        for (int pi2 = 0; pi2 < this.pn; pi2++) {

            this.Emit(this.pLines[pi2]);

        }

        // M17: registra slots heap como roots para GC tracing
        for (int i = 0; i < this.gRootN; i++) {
            int slot = this.gRoots[i];
            this.Emit("leaq " + this.Off(slot) + ", %rcx");
            this.Emit("subq $32, %rsp");
            this.Emit("call hphl_gc_add_root");
            this.Emit("addq $32, %rsp");
        }

        for (int i = 0; i < this.bn; i++) {

            this.Emit(this.bLines[i]);

        }

        this.Emit(this.fnRetLbl + ":");

        // Item 3 Fase 3: preserva o valor de retorno em slot (calls abaixo
        // clobberam %rax â€” sem isso, `return new X()` devolvia lixo quando a
        // funÃ§Ã£o tinha roots registrados).
        this.Emit("movq %rax, " + this.Off(retSlot));

        if (isMain) {
            this.Emit("subq $32, %rsp");
            this.Emit("call hphl_join_tasks");
            this.Emit("addq $32, %rsp");
        }

        // M17: remove roots (inverse order of add)
        for (int i = this.gRootN - 1; i >= 0; i--) {
            int slot = this.gRoots[i];
            this.Emit("leaq " + this.Off(slot) + ", %rcx");
            this.Emit("subq $32, %rsp");
            this.Emit("call hphl_gc_remove_root");
            this.Emit("addq $32, %rsp");
        }

        if (isMain) {
            this.Emit("subq $32, %rsp");
            this.Emit("call hphl_gc");
            this.Emit("addq $32, %rsp");
        }

        this.Emit("movq " + this.Off(retSlot) + ", %rax");

        this.Emit("leave");
        this.Emit("ret");

    }

    // passadas: coleta assinaturas/globals â†’ emite funÃ§Ãµes â†’ emite .data

    public     void GenProgram(Decl prog) {

        this.gProg = prog;
        for (int gi0 = 0; gi0 < 512; gi0++) this.gTlsOff[gi0] = -1;

        this.Emit(".Lsh_ovf:");

        this.Emit("xorl %ecx, %ecx");

        this.Emit("subq $32, %rsp");

        this.Emit("call hphl_panic");

        this.Emit("addq $32, %rsp");

        // M23.1 2.3: descobre instÃ¢ncias genÃ©ricas usadas e emite cÃ³pias
        // monomorfizadas. Faz antes da coleta de assinaturas para que as cÃ³pias
        // participem da tabela de funÃ§Ãµes/classes.
        this.discoverInstances(prog);
        this.emitMonomorphized(prog);

        Decl d = prog;

        while (d != null) {

            if (d.kind == PK.GVar) {

                this.gNames[this.gN] = d.name;

                this.gAtomic[this.gN] = d.isAtomic;

                this.gTlsOff[this.gN] = -1;
                if (d.isTls) {
                    this.gTlsOff[this.gN] = this.tlsBytes;
                    this.tlsBytes = this.tlsBytes + 8;
                }

                this.gTypes[this.gN] = d.retType;

                this.gVals[this.gN] = 0;

                this.gN = this.gN + 1;

            } else if (d.kind == PK.GVarArray) {

                this.gNames[this.gN] = d.name;

                this.gTypes[this.gN] = d.retType;

                this.gVals[this.gN] = 0;

                this.gSizes[this.gN] = d.arrSize;

                this.gN = this.gN + 1;

            } else if (d.kind == PK.Enum) {

                this.EnumPut(d.name, d.owner);

            } else if (d.kind == PK.Class || d.kind == PK.Struct || d.kind == PK.Interface || d.kind == PK.Actor) {

                // M15-fix: campos-array contam arrSize slots (name*sz)

                int fc = 0;

                string fl = "";

                Pm pfc = d.params;

                while (pfc != null) {

                    if (fl != "") fl = fl + ",";

                    int szf = 1;

                    if (pfc.arrSize > 0) szf = pfc.arrSize;

                    fl = fl + pfc.name + "*" + szf;

                    fc = fc + szf;

                    pfc = pfc.next;

                }

                if (d.fullBases != "") {
                    for (int bi = 0; bi < this.cN2; bi++) {
                        if (this.cNames[bi] == d.fullBases) {
                            if (this.cFlds[bi] != "") {
                                if (fl != "") fl = this.cFlds[bi] + "," + fl;
                                else fl = this.cFlds[bi];
                                fc = fc + this.cCnt[bi];
                            }
                            break;
                        }
                    }
                }

                bool isClsOrIface = (d.kind == PK.Class || d.kind == PK.Interface || d.kind == PK.Actor);
                this.ClsPut(d.name, fc, fl, d.fullBases, isClsOrIface);

            } else if (d.kind == PK.Fn) {

                int ar = 0;

                Pm p = d.params;

                while (p != null) {

                    ar = ar + 1;

                    p = p.next;

                }

                this.FnPut(d.name, d.retType, ar);

                // Item 3 Fase 3: ctor explícito tem owner == name (ver ParseClass)
                if (d.owner != "" && d.owner == d.name) {
                    this.ctorPut(d.name, ar - 1);
                } else if (d.owner != "") {
                    this.VSlotRegister(d.name, ar - 1);
                }

            }

            d = d.next;

        }

        d = prog;

        while (d != null) {

            if (d.kind == PK.Fn) this.GenFn(d);
            if (d.kind == PK.Class || d.kind == PK.Struct || d.kind == PK.Actor) this.GenDerivedMethods(d);

            d = d.next;

        }

        Decl lam = this.lambdaHead;
        while (lam != null) {
            this.GenFn(lam);
            lam = lam.next;
        }

        // globals inicializados com literal constante + stub do dbg meta

        this.Emit(".data");

        this.Emit(".globl hphl_dbg_meta");

        this.Emit("hphl_dbg_meta: .quad 0,0,0,0,0,0");

        this.Emit("hphl_exc_hdl: .quad 0");

        for (int ci = 0; ci < this.cN2; ci++) {
            if (this.cIsClass[ci] && this.vsN > 0) {
                this.Emit(".Lvt_" + this.cNames[ci] + ":");
                for (int si = 0; si < this.vsN; si++) {
                    string impl = this.FindMethodImpl(this.cNames[ci], this.vsName[si], this.vsArity[si]);
                    if (impl != "") {
                        this.Emit("  .quad " + impl);
                    } else {
                        this.Emit("  .quad 0");
                    }
                }
            }
        }

        // M15.2.2: literais de string internados (.asciz; escapes GAS nativos)

        // M17 Fase 3: percorre linked list de chunks
        StringChunk sc = this.sHead;
        while (sc != null) {
            for (int si = 0; si < sc.n; si++) {

                string body = sc.txts[si];

                var blen = str_len(body);

                string esc = hphl_gas_str(body);

                this.Emit(sc.lbls[si] + ": .asciz \"" + esc + "\"");

            }
            sc = sc.next;
        }

        // Item 3 Fase 2: literais float internados (.double; GAS aceita o texto)
        FloatChunk fc = this.fHead;
        while (fc != null) {
            for (int fi = 0; fi < fc.n; fi++) {
                this.Emit(fc.lbls[fi] + ": .double " + fc.txts[fi]);
            }
            fc = fc.next;
        }

        d = prog;

        while (d != null) {

            if (d.kind == PK.GVarArray) {

                this.Emit(".Lg_" + d.name + ": .zero " + (d.arrSize * 8));

            } else if (d.kind == PK.GVar) {

                if (d.isTls) {
                    d = d.next;
                    continue;
                }

                string v = "0";

                if (d.init != null) {

                    if (d.init.kind == NK.Num) {

                        v = d.init.text;

                    } else if (d.init.kind == NK.Un && d.init.left != null && d.init.left.kind == NK.Num) {

                        var nval = parse_int(d.init.left.text);

                        if (d.init.op == "-") v = "" + (-nval);

                        else if (d.init.op == "~") v = "" + (~nval);

                    }

                }

                // Item 3 Fase 2: global float usa .double (bits; load via movq)
                if (contains(v, ".") || contains(v, "e") || contains(v, "E")) {
                    this.Emit(".Lg_" + d.name + ": .double " + v);
                } else {
                    this.Emit(".Lg_" + d.name + ": .quad " + v);
                }

            }

            d = d.next;

        }

    }



    void GenDerivedMethods(Decl d) {
        string cname = d.name;
        string esLbl = this.InternStr("");

        this.Emit(".globl _sh_" + cname + "_Equals");
        this.Emit(".globl _sh_" + cname + "_Equals_1");
        this.Emit(".globl _sh_" + cname + "_Equals_2");
        this.Emit("_sh_" + cname + "_Equals:");
        this.Emit("_sh_" + cname + "_Equals_1:");
        this.Emit("_sh_" + cname + "_Equals_2:");
        this.Emit("  pushq %rbp");
        this.Emit("  movq %rsp, %rbp");
        this.Emit("  cmpq %rdx, %rcx");
        this.Emit("  je .Lde_eq_1_" + cname);
        this.Emit("  testq %rcx, %rcx");
        this.Emit("  jz .Lde_eq_0_" + cname);
        this.Emit("  testq %rdx, %rdx");
        this.Emit("  jz .Lde_eq_0_" + cname);

        int off = 8;
        Pm pf = d.params;
        while (pf != null) {
            this.Emit("  movq " + off + "(%rcx), %r8");
            this.Emit("  movq " + off + "(%rdx), %r9");
            if (pf.type == "string") {
                this.Emit("  pushq %rcx");
                this.Emit("  pushq %rdx");
                this.Emit("  movq %r8, %rcx");
                this.Emit("  movq %r9, %rdx");
                this.Emit("  subq $32, %rsp");
                this.Emit("  call hphl_str_eq");
                this.Emit("  addq $32, %rsp");
                this.Emit("  popq %rdx");
                this.Emit("  popq %rcx");
                this.Emit("  testq %rax, %rax");
                this.Emit("  jz .Lde_eq_0_" + cname);
            } else {
                this.Emit("  cmpq %r9, %r8");
                this.Emit("  jne .Lde_eq_0_" + cname);
            }
            int sz = 1;
            if (pf.arrSize > 0) sz = pf.arrSize;
            off = off + (sz * 8);
            pf = pf.next;
        }

        this.Emit(".Lde_eq_1_" + cname + ":");
        this.Emit("  movq $1, %rax");
        this.Emit("  popq %rbp");
        this.Emit("  ret");
        this.Emit(".Lde_eq_0_" + cname + ":");
        this.Emit("  movq $0, %rax");
        this.Emit("  popq %rbp");
        this.Emit("  ret");

        this.Emit(".globl _sh_" + cname + "_CompareTo");
        this.Emit(".globl _sh_" + cname + "_CompareTo_1");
        this.Emit(".globl _sh_" + cname + "_CompareTo_2");
        this.Emit("_sh_" + cname + "_CompareTo:");
        this.Emit("_sh_" + cname + "_CompareTo_1:");
        this.Emit("_sh_" + cname + "_CompareTo_2:");
        this.Emit("  pushq %rbp");
        this.Emit("  movq %rsp, %rbp");
        this.Emit("  cmpq %rdx, %rcx");
        this.Emit("  je .Lde_cmp_0_" + cname);
        this.Emit("  testq %rcx, %rcx");
        this.Emit("  jz .Lde_cmp_neg_" + cname);
        this.Emit("  testq %rdx, %rdx");
        this.Emit("  jz .Lde_cmp_pos_" + cname);

        off = 8;
        pf = d.params;
        while (pf != null) {
            this.Emit("  movq " + off + "(%rcx), %r8");
            this.Emit("  movq " + off + "(%rdx), %r9");
            if (pf.type == "string") {
                this.Emit("  pushq %rcx");
                this.Emit("  pushq %rdx");
                this.Emit("  movq %r8, %rcx");
                this.Emit("  movq %r9, %rdx");
                this.Emit("  subq $32, %rsp");
                this.Emit("  call strcmp");
                this.Emit("  addq $32, %rsp");
                this.Emit("  popq %rdx");
                this.Emit("  popq %rcx");
                this.Emit("  testl %eax, %eax");
                this.Emit("  js .Lde_cmp_neg_" + cname);
                this.Emit("  jg .Lde_cmp_pos_" + cname);
            } else {
                this.Emit("  cmpq %r9, %r8");
                this.Emit("  jl .Lde_cmp_neg_" + cname);
                this.Emit("  jg .Lde_cmp_pos_" + cname);
            }
            int sz = 1;
            if (pf.arrSize > 0) sz = pf.arrSize;
            off = off + (sz * 8);
            pf = pf.next;
        }

        this.Emit(".Lde_cmp_0_" + cname + ":");
        this.Emit("  movq $0, %rax");
        this.Emit("  popq %rbp");
        this.Emit("  ret");
        this.Emit(".Lde_cmp_neg_" + cname + ":");
        this.Emit("  movq $-1, %rax");
        this.Emit("  popq %rbp");
        this.Emit("  ret");
        this.Emit(".Lde_cmp_pos_" + cname + ":");
        this.Emit("  movq $1, %rax");
        this.Emit("  popq %rbp");
        this.Emit("  ret");

        this.Emit(".globl _sh_" + cname + "_Clone");
        this.Emit(".globl _sh_" + cname + "_Clone_0");
        this.Emit(".globl _sh_" + cname + "_Clone_1");
        this.Emit("_sh_" + cname + "_Clone:");
        this.Emit("_sh_" + cname + "_Clone_0:");
        this.Emit("_sh_" + cname + "_Clone_1:");
        this.Emit("  pushq %rbp");
        this.Emit("  movq %rsp, %rbp");
        this.Emit("  movq %rcx, %rax");
        this.Emit("  popq %rbp");
        this.Emit("  ret");

        this.Emit(".globl _sh_" + cname + "_Hash");
        this.Emit(".globl _sh_" + cname + "_Hash_0");
        this.Emit(".globl _sh_" + cname + "_Hash_1");
        this.Emit("_sh_" + cname + "_Hash:");
        this.Emit("_sh_" + cname + "_Hash_0:");
        this.Emit("_sh_" + cname + "_Hash_1:");
        this.Emit("  pushq %rbp");
        this.Emit("  movq %rsp, %rbp");
        this.Emit("  movq %rcx, %rax");
        this.Emit("  popq %rbp");
        this.Emit("  ret");

        this.Emit(".globl _sh_" + cname + "_Serialize");
        this.Emit(".globl _sh_" + cname + "_Serialize_0");
        this.Emit(".globl _sh_" + cname + "_Serialize_1");
        this.Emit("_sh_" + cname + "_Serialize:");
        this.Emit("_sh_" + cname + "_Serialize_0:");
        this.Emit("_sh_" + cname + "_Serialize_1:");
        this.Emit("  pushq %rbp");
        this.Emit("  movq %rsp, %rbp");
        this.Emit("  leaq " + esLbl + "(%rip), %rax");
        this.Emit("  popq %rbp");
        this.Emit("  ret");
    }

    // escreve o assembly acumulado no arquivo (chunks de 48 linhas)

    public void FlushTo(string path) {

        write_file(path, "");

        string chunk = "";

        for (int i = 0; i < this.ln; i++) {

            chunk = chunk + this.lines[i] + "\n";

            if ((i + 1) % 48 == 0) {

                append_file(path, chunk);

                chunk = "";

            }

        }

        if (chunk != "") append_file(path, chunk);

    }

}
