module Codegen;

/*
===========================================================================
    selfhost/src/codegen/codegen.hphl — Gerador de código x64 em HP-HL
    Espelha compiler/src/codegen/
===========================================================================
*/

import "../ast/ast.hphl";

// M17 Fase 3: chunk dinÃ¢mico para string intern (linked list de chunks)
class StringChunk {
    string[500] lbls;
    string[500] txts;
    StringChunk next;
    int n; // count of entries in this chunk
}

// Item 3 Fase 2: chunk dinÃ¢mico para float intern (pool .double na .data).
// Literais float ("3.14159") sÃ£o internados como `.Lsh_f<N>: .double <text>`
// e carregados com `movq lbl(%rip), %rax` (bits viajam no modelo de slots).
class FloatChunk {
    string[500] lbls;
    string[500] txts;
    FloatChunk next;
    int n; // count of entries in this chunk
}

class CG {

    string[350000] lines;

    int ln;

    string[512] gNames;
    bool[512] gAtomic;
    int[512] gTlsOff;
    int tlsBytes;

    string[512] gTypes;

    int[512] gVals;

    int gN;

    int[512] gSizes;

    string[256] cNames;

    int[256] cCnt;

    string[256] cFlds;

    string[256] cBase;

    bool[256] cIsClass;

    string[2048] vsName;

    int[2048] vsArity;

    int vsN;

    string[128] eN2;

    string[128] eV2;

    int eN;

    int cN2;

    string[2048] fNames;

    string[2048] fRets;

    int[2048] fArity;

    int fN;

    // M23.1 2.3: tabela de instâncias monomorfizadas (base + args -> mangled).
    // Ex: ("Caixa", "int") -> "Caixa__int"; ("Caixa", "string") -> "Caixa__string".
    string[256] miBase;   // "Caixa"
    string[256] miArgs;   // "int" (csv)
    string[256] miMangled; // "Caixa__int"
    int miN;

    // Item 3 Fase 3: classes com construtor explícito (nome == owner).
    // `new C()` sem args precisa CHAMAR o ctor zero-arg (antes, o ctor só
    // era chamado com args — sHead/sTail do CG ficavam NULL no bootstrap).
    string[256] ctorNames;
    int[256] ctorArity; // aridade SEM contar o this implícito
    int ctorN;

    // M23.1 2.3: tipoParams por Decl (declaraÃ§Ã£o). Para classes, lista de
    // typeParam names; para funÃ§Ãµes tambÃ©m. Usado para validar aridade e
    // renomear cÃ³pias monomorfizadas.
    // NOTA: o selfhost parser nÃ£o extrai typeParams, entÃ£o usamos uma heurÃ­stica
    // simples: se uma classe/funÃ§Ã£o tem alguma referÃªncia genÃ©rica em um uso,
    // ela Ã© genÃ©rica. As instÃ¢ncias descobertas determinam as cÃ³pias.

    // M23 2.8: 1024->2048 para selfhost E2E
    string[2048] lNames;

    int[2048] lSlots;

    int[2048] lSizes;

    string[2048] lTypes;

    string[2048] lRefKinds;
    bool[2048] lAtomic;
    bool[2048] lIsPtr;

    int lN;


    int nextSlot;

    int[256] gRoots; // M17: slots que cont\u00eam ponteiros heap (roots p/ GC tracing)

    int gRootN;

    int lbl;

    string curRet;

    string curOwner;
    bool curIsTask;

    Decl gProg;

    string arrCsv;

    string arrG;

    int arrBaseF;

    int arrSizeF;

    Decl lambdaHead;
    Decl lambdaTail;
    int lambdaCounter;
    int taskCounter;

    public CG() {

        this.ln = 0;

        this.gN = 0;

        this.fN = 0;

        this.lN = 0;

        this.gRootN = 0;

        this.lbl = 0;

        this.lambdaHead = null;
        this.lambdaTail = null;
        this.lambdaCounter = 0;
        this.taskCounter = 0;
        this.curIsTask = false;
        this.tlsBytes = 0;

        this.lblSp = 0;

        this.miN = 0; // M23.1 2.3: tabela de instÃ¢ncias

        this.ctorN = 0; // Item 3 Fase 3: tabela de construtores

        this.curOwner = "";

        this.pn = 0;

        this.inParam = 0;

        // M17 Fase 3: aloca primeiro chunk do string intern din\u00e2mico
        this.sHead = new StringChunk();
        this.sHead.n = 0;
        this.sHead.next = null;
        this.sTail = this.sHead;
        // Item 3 Fase 2: aloca primeiro chunk do float intern dinamico
        this.fHead = new FloatChunk();
        this.fHead.n = 0;
        this.fHead.next = null;
        this.fTail = this.fHead;
    }


    // M23.1 2.3: mangling. Caixa<int> -> "Caixa__int"; Foo<int,string> -> "Foo__int_string"
    string mangle(string nm, string args) {
        if (args == "") return nm;
        string r = nm + "__";
        var blen = str_len(args);
        for (int k = 0; k < blen; k++) {
            string ch = sub_str(args, k, 1);
            if (ch == "," || ch == " ") ch = "_";
            if (ch == "<" || ch == ">") ch = "_";
            r = r + ch;
        }
        return r;
    }

    // M23.1 2.3: junta args em CSV simples (sem < > ,). Usa this._cgaArgs
    // como buffer (workaround p/ selfhost M2 nÃ£o suportar string[] em param).
    string[8] _cgaArgs;
    string joinArgs(int count) {
        string r = "";
        for (int i = 0; i < count; i++) {
            if (i > 0) r = r + "_";
            r = r + this._cgaArgs[i];
        }
        return r;
    }

    // Item 3 Fase 3: registra ctor explícito (owner == name na Decl).
    void ctorPut(string nm, int userArity) {
        for (int i = 0; i < this.ctorN; i++) {
            if (this.ctorNames[i] == nm && this.ctorArity[i] == userArity) return;
        }
        if (this.ctorN < 256) {
            this.ctorNames[this.ctorN] = nm;
            this.ctorArity[this.ctorN] = userArity;
            this.ctorN = this.ctorN + 1;
        }
    }

    // aridade do ctor (sem this) ou -1 se a classe não tem ctor explícito
    int ctorArityOf(string nm) {
        for (int i = 0; i < this.ctorN; i++) {
            if (this.ctorNames[i] == nm) return this.ctorArity[i];
        }
        return -1;
    }

    bool hasCtor(string nm, int userArity) {
        for (int i = 0; i < this.ctorN; i++) {
            if (this.ctorNames[i] == nm && this.ctorArity[i] == userArity) return true;
        }
        return false;
    }

    // M23.1 2.3: registra uma instÃ¢ncia. Copia args pra this._cgaArgs primeiro.
    string instPut(string nm, int count) {
        int k = 0;
        while (k < count) { this._cgaArgs[k] = this._cgaArgs[k]; k = k + 1; }
        string csv = this.joinArgs(count);
        string m = this.mangle(nm, csv);
        for (int i = 0; i < this.miN; i++) {
            if (this.miBase[i] == nm && this.miArgs[i] == csv) return this.miMangled[i];
        }
        if (this.miN < 60) {
            this.miBase[this.miN] = nm;
            this.miArgs[this.miN] = csv;
            this.miMangled[this.miN] = m;
            this.miN = this.miN + 1;
        }
        return m;
    }

    // M23.1 2.3: lookup de instÃ¢ncia. args deve estar em this._cgaArgs.
    string instGet(string nm, int count) {
        string csv = this.joinArgs(count);
        for (int i = 0; i < this.miN; i++) {
            if (this.miBase[i] == nm && this.miArgs[i] == csv) return this.miMangled[i];
        }
        return ""; // nÃ£o monomorfizada
    }

    // M23.1 2.3: percorre o programa e descobre instÃ¢ncias genÃ©ricas usadas.
    // Chama instPut para cada uso `new Foo<X>` ou `Foo<X>(...)`.
    void discoverInNode(Node n) {
        if (n == null) return;
        if (n.kind == NK.New && n.genArgsC > 0) {
            int gi = 0;
            while (gi < n.genArgsC) { this._cgaArgs[gi] = n.genArgs[gi]; gi = gi + 1; }
            this.instPut(n.text, n.genArgsC);
        } else if (n.kind == NK.Call && n.genArgsC > 0) {
            int gi = 0;
            while (gi < n.genArgsC) { this._cgaArgs[gi] = n.genArgs[gi]; gi = gi + 1; }
            this.instPut(n.text, n.genArgsC);
        }
        if (n.left != null) this.discoverInNode(n.left);
        if (n.right != null) this.discoverInNode(n.right);
        if (n.arg != null) this.discoverInNode(n.arg);
        if (n.next != null) this.discoverInNode(n.next);
        if (n.recv != null) this.discoverInNode(n.recv);
    }

    // Item 3 Fase 3: travessia LINEAR (cada nÃ³ visitado 1x). Antes, a
    // combinaÃ§Ã£o de recursÃ£o em s.body + loop em s.next re-percorria as
    // cadeias internas a cada nÃ­vel de aninhamento (complexidade exponencial
    // em blocos aninhados â€” travava o bootstrap em discoverInstances).
    // Agora: irmÃ£os via loop, filhos via recursÃ£o.
    void discoverInStmt(Stmt s) {
        Stmt cur = s;
        while (cur != null) {
            if (cur.kind == SK.VarDecl && cur.genArgsC > 0) {
                int gi = 0;
                while (gi < cur.genArgsC) { this._cgaArgs[gi] = cur.genArgs[gi]; gi = gi + 1; }
                this.instPut(cur.name, cur.genArgsC);
            }
            this.discoverInNode(cur.expr);
            this.discoverInNode(cur.targetIdx);
            this.discoverInNode(cur.targetMember);
            this.discoverInStmt(cur.body);
            this.discoverInStmt(cur.elseBody);
            this.discoverInStmt(cur.initS);
            this.discoverInStmt(cur.stepS);
            cur = cur.next;
        }
    }

    void discoverInDecl(Decl d) {
        if (d == null) return;
        Pm pm = d.params;
        while (pm != null) {
            if (pm.genArgsC > 0) {
                int gi = 0;
                while (gi < pm.genArgsC) { this._cgaArgs[gi] = pm.genArgs[gi]; gi = gi + 1; }
                this.instPut(pm.type, pm.genArgsC);
            }
            pm = pm.next;
        }
        this.discoverInNode(d.init);
        this.discoverInStmt(d.body);
        this.discoverInDecl(d.next);
    }

    void discoverInstances(Decl prog) {
        this.discoverInDecl(prog);
    }

    // M23.1 2.3: copia profunda de Pm (params). name/type mantidos; outros
    // campos resetados.
    Pm copyPmList(Pm head) {
        Pm rhead = null;
        Pm rtail = null;
        while (head != null) {
            Pm np = new Pm();
            np.type = head.type;
            np.name = head.name;
            np.arrSize = head.arrSize;
            np.symDim = head.symDim;
            np.genArgsC = head.genArgsC;
            int gi = 0;
            while (gi < np.genArgsC) { np.genArgs[gi] = head.genArgs[gi]; gi = gi + 1; }
            if (rhead == null) {
                rhead = np;
                rtail = np;
            } else {
                this.pmAppend(rtail, np);
                rtail = np;
            }
            head = head.next;
        }
        return rhead;
    }

    // M23.1 2.3: anexa tail ao final de head (helper para evitar NULL DEREF no
    // host quando o caller garante que head nÃ£o Ã© null).
    void pmAppend(Pm head, Pm tail) {
        head.next = tail;
    }

    // M23.1 2.3: clona um Decl substituindo name/owner/retType (mangled) e
    // params (cÃ³pia profunda). body NÃƒO Ã© copiado â€” compartilhado (mesma AST
    // Ã© reutilizada; GenFn usa o nome novo no label).
    Node SubstExpr(Node n, string nm, string val) {
        if (n == null) return null;
        if (n.kind == NK.Var && n.text == nm) {
            Node num = mkNum(val);
            num.tyHint = "int";
            return num;
        }
        n.left = this.SubstExpr(n.left, nm, val);
        n.right = this.SubstExpr(n.right, nm, val);
        n.arg = this.SubstExpr(n.arg, nm, val);
        n.recv = this.SubstExpr(n.recv, nm, val);
        return n;
    }

    Stmt substBody(Stmt s, string nm, string val) {
        if (s == null) return null;
        s.expr = this.SubstExpr(s.expr, nm, val);
        s.targetIdx = this.SubstExpr(s.targetIdx, nm, val);
        if (s.targetMember != null) s.targetMember = this.SubstExpr(s.targetMember, nm, val);
        if (s.body != null) s.body = this.substBody(s.body, nm, val);
        if (s.elseBody != null) s.elseBody = this.substBody(s.elseBody, nm, val);
        if (s.initS != null) s.initS = this.substBody(s.initS, nm, val);
        if (s.stepS != null) s.stepS = this.substBody(s.stepS, nm, val);
        if (s.next != null) s.next = this.substBody(s.next, nm, val);
        return s;
    }

    Node CloneNode(Node n) {
        if (n == null) return null;
        Node c = new Node();
        c.kind = n.kind;
        c.text = n.text;
        c.op = n.op;
        c.left = this.CloneNode(n.left);
        c.right = this.CloneNode(n.right);
        c.recv = this.CloneNode(n.recv);
        c.tyHint = n.tyHint;
        c.subjBind = n.subjBind;
        c.fullTy = n.fullTy;
        c.refKind = n.refKind;
        c.genArgsC = n.genArgsC;
        for (int gi = 0; gi < n.genArgsC; gi++) c.genArgs[gi] = n.genArgs[gi];
        c.argNamesC = n.argNamesC;
        for (int gi = 0; gi < n.argNamesC; gi++) c.argNames[gi] = n.argNames[gi];
        c.lamSelfName = n.lamSelfName;
        c.lamFnLabel = n.lamFnLabel;
        c.isIndirectCall = n.isIndirectCall;
        c.lamParams = this.copyPmList(n.lamParams);
        c.lamCaptures = this.copyPmList(n.lamCaptures);
        c.lamBody = this.CloneStmt(n.lamBody);
        c.next = null;
        c.arg = null;
        Node ta = n.arg;
        Node th = null;
        while (ta != null) {
            Node ca = this.CloneNode(ta);
            ca.next = null;
            if (th == null) {
                th = ca;
            } else {
                Node tl = th;
                while (tl.next != null) tl = tl.next;
                tl.next = ca;
            }
            ta = ta.next;
        }
        c.arg = th;
        return c;
    }

    Stmt CloneStmt(Stmt s) {
        if (s == null) return null;
        Stmt c = new Stmt();
        c.kind = s.kind;
        c.name = s.name;
        c.text = s.text;
        c.op = s.op;
        c.expr = this.CloneNode(s.expr);
        c.targetIdx = this.CloneNode(s.targetIdx);
        c.targetMember = this.CloneNode(s.targetMember);
        c.isArray = s.isArray;
        c.arrSize = s.arrSize;
        c.elemStride = s.elemStride;
        c.fullTy = s.fullTy;
        c.isAtomic = s.isAtomic;
        c.catchType = s.catchType;
        c.catchVar = s.catchVar;
        c.genArgsC = s.genArgsC;
        for (int gi = 0; gi < s.genArgsC; gi++) c.genArgs[gi] = s.genArgs[gi];
        c.body = this.CloneStmt(s.body);
        c.elseBody = this.CloneStmt(s.elseBody);
        c.initS = this.CloneStmt(s.initS);
        c.stepS = this.CloneStmt(s.stepS);
        c.next = this.CloneStmt(s.next);
        return c;
    }

    Decl cloneDeclForInstance(Decl src, string newName) {
        Decl nd = new Decl();
        nd.kind = src.kind;
        nd.retType = src.retType;
        nd.name = newName;
        nd.owner = newName; // mÃ©todos viram "Caixa__int.Obter" via newName
        nd.arrSize = src.arrSize;
        nd.init = src.init;
        nd.params = this.copyPmList(src.params);
        nd.body = this.CloneStmt(src.body);
        return nd;
    }

    // M23.1 2.3: encontra um Decl pelo nome no programa
    Decl findDecl(Decl prog, string name) {
        Decl d = prog;
        while (d != null) {
            if (d.name == name) return d;
            d = d.next;
        }
        return null;
    }

    // M23.1 2.3: anexa Decl ao final de uma lista encadeada
    void appendDecl(Decl prog, Decl newD) {
        if (prog == null) return;
        Decl it = prog;
        while (it.next != null) it = it.next;
        it.next = newD;
    }

    // M23.1 2.3: emite cÃ³pias monomorfizadas de classes e funÃ§Ãµes usadas
    // com generics. As cÃ³pias sÃ£o anexadas ao final do programa (depois dos
    // originais) e emitidas naturalmente pelo loop existente.
    // Para classes: cria cÃ³pias PK.Class com o nome mangled; seus mÃ©todos
    // (que estÃ£o no `next` da classe original como PK.Fn com owner=cname)
    // precisam ser COPIADOS tambÃ©m com owner=newname.
    void emitMonomorphized(Decl prog) {
        // 1. Para cada instÃ¢ncia na tabela, encontra o Decl original
        // 2. Se for classe, copia o Decl inteiro (params = campos, next = mÃ©todos)
        //    e renomeia. Os mÃ©todos tambÃ©m precisam de cÃ³pias com owner novo.
        // 3. Se for funÃ§Ã£o top-level, copia com nome novo.
        //
        // NOTA: como o selfhost nÃ£o tem typeParams, nÃ£o validamos aridade. Se
        // `Foo` Ã© usada sem generics, nÃ£o monomorfiza.
        int i = 0;
        while (i < this.miN) {
            string baseNm = this.miBase[i];
            string mangled = this.miMangled[i];
            Decl orig = this.findDecl(prog, baseNm);
            if (orig == null) { i = i + 1; continue; }
            if (orig.kind == PK.Class) {
                // args da instancia (csv "int, 64") -> vals posicionais
                string argsCsv = this.miArgs[i];
                string[8] vals;
                int valC = 0;
                int startV = 0;
                int lenV = str_len(argsCsv);
                for (int k = 0; k <= lenV; k++) {
                    if (k == lenV || sub_str(argsCsv, k, 1) == "_") {
                        string part = sub_str(argsCsv, startV, k - startV);
                        if (valC < 8) { vals[valC] = part; valC = valC + 1; }
                        startV = k + 1;
                    }
                }
                // dim simbolica do template + seu valor posicional
                string dimNm = "";
                string dimVal = "";
                Pm pfc2 = orig.params;
                while (pfc2 != null) {
                    if (pfc2.symDim != "") {
                        int ti = 0;
                        while (ti < orig.genArgsC) {
                            string tp = orig.genArgs[ti];
                            int tl = str_len(tp);
                            int sl = str_len(pfc2.symDim);
                            if (tp == pfc2.symDim || (tl > sl && sub_str(tp, tl - sl, sl) == pfc2.symDim)) {
                                if (ti < valC) { dimNm = pfc2.symDim; dimVal = vals[ti]; }
                                break;
                            }
                            ti = ti + 1;
                        }
                        break;
                    }
                    pfc2 = pfc2.next;
                }
                // copia a classe (campos no params) com nome novo
                Decl cls = this.cloneDeclForInstance(orig, mangled);
                Pm cp2 = cls.params;
                while (cp2 != null) {
                    if (cp2.type == "T" && valC > 0) cp2.type = vals[0];
                    else if (cp2.type == "T[]" && valC > 0) cp2.type = vals[0] + "[]";
                    if (dimNm != "" && cp2.symDim == dimNm) {
                        var dv = parse_int(dimVal);
                        cp2.arrSize = dv;
                        cp2.symDim = "";
                    }
                    cp2 = cp2.next;
                }
                // copia mÃ©todos (no next da classe) com owner novo
                // IMPORTANTE: sÃ³ copia os mÃ©todos que PERTENCEM Ã  classe (owner == baseNm).
                Decl mSrc = orig.next;
                Decl mTail = cls;
                while (mSrc != null && mSrc.owner == baseNm) {
                    bool isCtor = (mSrc.name == baseNm);
                    // nome do construtor: deve ser igual ao tipo (C__int), nÃ£o "C"
                    string newMName = isCtor ? mangled : mSrc.name;
                    Decl m = this.cloneDeclForInstance(mSrc, newMName);
                    m.owner = mangled;
                    if (isCtor) m.retType = mangled;
                    if (dimNm != "" && dimVal != "") {
                        m.body = this.substBody(m.body, dimNm, dimVal);
                    }
                    mTail.next = m;
                    mTail = m;
                    mSrc = mSrc.next;
                }
                this.appendDecl(prog, cls);
            } else if (orig.kind == PK.Fn) {
                // M23.1 2.3: função top-level genérica (ex: T Primeiro<T>(T a, T b))
                // é copiada com nome mangled, mas owner vazio (é top-level).
                Decl fn = this.cloneDeclForInstance(orig, mangled);
                fn.owner = "";
                string typeArg = this.miArgs[i];
                if (fn.retType == orig.whereParam || fn.retType == "T") {
                    fn.retType = typeArg;
                }
                Pm cpm = fn.params;
                while (cpm != null) {
                    if (cpm.type == orig.whereParam || cpm.type == "T") {
                        cpm.type = typeArg;
                    } else if (starts_with(cpm.type, "list<") || cpm.type == "list") {
                        cpm.type = "list<" + typeArg + ">";
                    }
                    cpm = cpm.next;
                }
                this.appendDecl(prog, fn);
            }
            i = i + 1;
        }
    }



    void EnumPut(string name, string vals) {

        this.eN2[this.eN] = name;

        this.eV2[this.eN] = vals;

        this.eN = this.eN + 1;

    }



    int EnumValOf(string ename, string variant) {

        for (int i = 0; i < this.eN; i++) {

            if (this.eN2[i] != ename) continue;

            string vs = this.eV2[i];

            var blen = str_len(vs);

            int cur = 0;

            int start = 0;

            for (int k = 0; k <= blen; k++) {

                if (k == blen || sub_str(vs, k, 1) == ",") {

                    string seg = sub_str(vs, start, k - start);

                    var eq = index_of(seg, "=");

                    if ((int)eq > 0) {

                        string sv = sub_str(seg, (int)eq + 1, str_len(seg) - (int)eq - 1);

                        var pv = parse_int(sv);

                        cur = (int)pv;

                        seg = sub_str(seg, 0, (int)eq);

                    }

                    var poX = index_of(seg, "(");
                    string segN = seg;
                    if ((int)poX > 0) segN = sub_str(seg, 0, (int)poX);
                    if (segN == variant) return cur;

                    cur = cur + 1;

                    start = k + 1;

                }

            }

        }

        return -1;

    }

    bool IsEnum(string name) {
        string b = name;
        var bk = index_of(name, "<");
        if (bk > 0) b = sub_str(name, 0, bk);
        for (int i = 0; i < this.eN; i++) {
            if (this.eN2[i] == b) return true;
        }
        return false;
    }

    string BaseOfTy(string t) {
        var u = index_of(t, "__");
        if (u > 0) return sub_str(t, 0, u);
        var lb = index_of(t, "<");
        if (lb > 0) return sub_str(t, 0, lb);
        return t;
    }

    bool HasPolicy(string t) {
        return contains(t, "<") && (contains(t, "wrap") || contains(t, "checked") ||
                                    contains(t, "saturate") || contains(t, "promote"));
    }

    int PolBits(string t) {
        var lb = index_of(t, "<");
        if (lb < 0) return 0;
        string inner = sub_str(t, lb + 1, str_len(t) - lb - 1);
        string num = "";
        for (int i = 0; i < str_len(inner); i++) {
            string ch = sub_str(inner, i, 1);
            if (ch == "," || ch == ">") break;
            num = num + ch;
        }
        if (num == "") return 0;
        var v = parse_int(num);
        return v;
    }

    string PolKind(string t) {
        var co = index_of(t, ",");
        if (co < 0) return "";
        string k = sub_str(t, co + 1, str_len(t) - co - 1);
        var gt = index_of(k, ">");
        if (gt > 0) k = sub_str(k, 0, gt);
        while (str_len(k) > 0 && sub_str(k, 0, 1) == " ") k = sub_str(k, 1, str_len(k) - 1);
        return k;
    }

    // politica de overflow sobre o valor em %rax (bits; float via bits->xmm)
    void EmitPolicy(string ty) {
        string kind = this.PolKind(ty);
        int bits = this.PolBits(ty);
        string base = this.BaseOfTy(ty);
        bool isInt = base == "int" || base == "uint" || base == "u8" || base == "u16" ||
                     base == "u32" || base == "u64" || base == "char" || base == "bool";
        if (kind == "promote" || kind == "") return;
        if (isInt) {
            if (kind == "wrap") {
                if (bits > 0 && bits < 64) {
                    this.Emit("shlq $" + (64 - bits) + ", %rax");
                    this.Emit("sarq $" + (64 - bits) + ", %rax");
                }
                return;
            }
            var half = 1;
            for (int i = 1; i < bits; i++) half = half * 2;
            var hi = half - 1;
            var lo = -half;
            string dHi = this.NewLbl("sat_hi");
            string dLo = this.NewLbl("sat_lo");
            string dDone = this.NewLbl("sat_done");
            this.Emit("cmpq $" + hi + ", %rax");
            this.Emit("jg " + dHi);
            this.Emit("cmpq $" + lo + ", %rax");
            this.Emit("jl " + dLo);
            this.Emit("jmp " + dDone);
            this.Emit(dHi + ":");
            this.Emit("movq $" + hi + ", %rax");
            this.Emit("jmp " + dDone);
            this.Emit(dLo + ":");
            this.Emit("movq $" + lo + ", %rax");
            this.Emit(dDone + ":");
            return;
        }
        if (base == "float" || base == "double") {
            if (bits != 32) return;
            string fPos = this.InternFloat("3.4028234663852886e+38");
            string fNeg = this.InternFloat("-3.4028234663852886e+38");
            int saveT = this.NewTmp();
            string dNeg = this.NewLbl("fpol_neg");
            string dKeep = this.NewLbl("fpol_keep");
            string dDone = this.NewLbl("fpol_done");
            this.Emit("movq %rax, %xmm1");
            this.Emit("movq %rax, " + this.Off(saveT));
            this.Emit("movq " + fPos + "(%rip), %rax");
            this.Emit("movq %rax, %xmm2");
            this.Emit("comisd %xmm2, %xmm1");
            this.Emit("jbe " + dNeg);
            if (kind == "checked") {
                string msg = this.InternStr("float overflow");
                this.Emit("leaq " + msg + "(%rip), %rcx");
                this.Emit("subq $32, %rsp");
                this.Emit("call hphl_panic");
                this.Emit("addq $32, %rsp");
            } else {
                this.Emit("movq " + fPos + "(%rip), %rax");
            }
            this.Emit("jmp " + dDone);
            this.Emit(dNeg + ":");
            this.Emit("movq " + this.Off(saveT) + ", %rax");
            this.Emit("movq %rax, %xmm1");
            this.Emit("movq " + fNeg + "(%rip), %rax");
            this.Emit("movq %rax, %xmm2");
            this.Emit("comisd %xmm2, %xmm1");
            this.Emit("jae " + dKeep);
            if (kind == "checked") {
                string msg2 = this.InternStr("float overflow");
                this.Emit("leaq " + msg2 + "(%rip), %rcx");
                this.Emit("subq $32, %rsp");
                this.Emit("call hphl_panic");
                this.Emit("addq $32, %rsp");
            } else {
                this.Emit("movq " + fNeg + "(%rip), %rax");
            }
            this.Emit("jmp " + dDone);
            this.Emit(dKeep + ":");
            this.Emit("movq " + this.Off(saveT) + ", %rax");
            this.Emit(dDone + ":");
            return;
        }
    }

    bool IsRichEnum(string name) {
        string b = name;
        var bk = index_of(name, "<");
        if (bk > 0) b = sub_str(name, 0, bk);
        for (int i = 0; i < this.eN; i++) {
            if (this.eN2[i] != b) continue;
            if (contains(this.eV2[i], "(")) return true;
        }
        return false;
    }

    string EnumSegPayload(string ename, string variant) {
        for (int i = 0; i < this.eN; i++) {
            if (this.eN2[i] != ename) continue;
            string vs = this.eV2[i];
            var blen = str_len(vs);
            int start = 0;
            for (int k = 0; k <= blen; k++) {
                if (k == blen || sub_str(vs, k, 1) == ",") {
                    string seg = sub_str(vs, start, k - start);
                    string sn = seg;
                    var eq2 = index_of(seg, "=");
                    if ((int)eq2 > 0) sn = sub_str(seg, 0, (int)eq2);
                    var po2 = index_of(sn, "(");
                    if ((int)po2 > 0) sn = sub_str(sn, 0, (int)po2);
                    if (sn == variant) {
                        var po = index_of(seg, "(");
                        if ((int)po < 0) return "";
                        var pc = index_of(seg, ")");
                        if ((int)pc < 0) return "";
                        return sub_str(seg, (int)po + 1, (int)pc - (int)po - 1);
                    }
                    start = k + 1;
                }
            }
        }
        return "";
    }

    int EnumPayloadCount(string ename, string variant) {
        string inner = this.EnumSegPayload(ename, variant);
        if (inner == "") return 0;
        int c = 1;
        for (int i = 0; i < str_len(inner); i++) {
            if (sub_str(inner, i, 1) == "|") c = c + 1;
        }
        return c;
    }

    string EnumOfVariant(string variant) {
        for (int i = 0; i < this.eN; i++) {
            string vs = this.eV2[i];
            var blen = str_len(vs);
            int start = 0;
            for (int k = 0; k <= blen; k++) {
                if (k == blen || sub_str(vs, k, 1) == ",") {
                    string seg = sub_str(vs, start, k - start);
                    string sn = seg;
                    var eq2 = index_of(seg, "=");
                    if ((int)eq2 > 0) sn = sub_str(seg, 0, (int)eq2);
                    var po2 = index_of(sn, "(");
                    if ((int)po2 > 0) sn = sub_str(sn, 0, (int)po2);
                    if (sn == variant) return this.eN2[i];
                    start = k + 1;
                }
            }
        }
        return "";
    }

    string EnumPayloadTy(string ename, string variant, int idx) {
        string inner = this.EnumSegPayload(ename, variant);
        int cur = 0;
        int start = 0;
        int n = str_len(inner);
        for (int i = 0; i <= n; i++) {
            string ch = "|";
            if (i < n) ch = sub_str(inner, i, 1);
            if (ch == "|") {
                if (cur == idx) {
                    string part = sub_str(inner, start, i - start);
                    var hh = index_of(part, "#");
                    if ((int)hh > 0) return sub_str(part, 0, (int)hh);
                    return part;
                }
                cur = cur + 1;
                start = i + 1;
            }
        }
        return "";
    }



    void ClsPut(string name, int cnt, string flds, string baseCls, bool isClass) {

        this.cNames[this.cN2] = name;

        this.cCnt[this.cN2] = cnt;

        this.cFlds[this.cN2] = flds;

        this.cBase[this.cN2] = baseCls;

        this.cIsClass[this.cN2] = isClass;

        this.cN2 = this.cN2 + 1;

    }

    bool IsClass(string name) {
        string baseName = name;
        var bk = index_of(name, "<");
        if (bk > 0) baseName = sub_str(name, 0, bk);
        for (int i = 0; i < this.cN2; i++) {
            if (this.cNames[i] == baseName && this.cIsClass[i]) return true;
        }
        return false;
    }

    bool IsStruct(string name) {
        string baseName = name;
        var bk = index_of(name, "<");
        if (bk > 0) baseName = sub_str(name, 0, bk);
        for (int i = 0; i < this.cN2; i++) {
            if (this.cNames[i] == baseName && !this.cIsClass[i]) return true;
        }
        return false;
    }

    bool IsFloatTy(string t) {
        if (t == "float" || t == "double") return true;
        if (starts_with(t, "float<") || starts_with(t, "double<")) return true;
        return false;
    }

    int ThisRecvSlot() {
        int r = this.NewTmp();
        int thisSlot = this.LocalSlot("this");
        if (thisSlot < 0) thisSlot = 0;
        this.Emit("movq " + this.Off(thisSlot) + ", %rax");
        this.Emit("movq %rax, " + this.Off(r));
        return r;
    }

    string OptHead(string t) {
        var lb = index_of(t, "<");
        string h = t;
        if (lb > 0) h = sub_str(t, 0, lb);
        if (h == "Option" || h == "option") return "option";
        if (h == "Result" || h == "result") return "result";
        return h;
    }

    string OptElem(string t) {
        var lb = index_of(t, "<");
        if (lb < 0) return "";
        return sub_str(t, lb + 1, str_len(t) - lb - 2);
    }

    string TrimSp(string s) {
        while (str_len(s) > 0 && sub_str(s, 0, 1) == " ") s = sub_str(s, 1, str_len(s) - 1);
        while (str_len(s) > 0 && sub_str(s, str_len(s) - 1, 1) == " ") s = sub_str(s, 0, str_len(s) - 1);
        return s;
    }

    string ResT(string t) {
        string inner = this.OptElem(t);
        int depth = 0;
        for (int i = 0; i < str_len(inner); i++) {
            string ch = sub_str(inner, i, 1);
            if (ch == "<") depth = depth + 1;
            else if (ch == ">") depth = depth - 1;
            else if (ch == "," && depth == 0) return this.TrimSp(sub_str(inner, 0, i));
        }
        return this.TrimSp(inner);
    }

    string ResE(string t) {
        string inner = this.OptElem(t);
        int depth = 0;
        for (int i = 0; i < str_len(inner); i++) {
            string ch = sub_str(inner, i, 1);
            if (ch == "<") depth = depth + 1;
            else if (ch == ">") depth = depth - 1;
            else if (ch == "," && depth == 0) return this.TrimSp(sub_str(inner, i + 1, str_len(inner) - i - 1));
        }
        return "";
    }

    bool IsOptionTy(string t) {
        return this.OptHead(t) == "option";
    }

    bool IsResultTy(string t) {
        return this.OptHead(t) == "result";
    }

    bool IsAsyncFn(string name) {
        Decl dd = this.gProg;
        while (dd != null) {
            if (dd.kind == PK.Fn && dd.owner == "" && dd.name == name && dd.isAsync) return true;
            dd = dd.next;
        }
        return false;
    }

    bool IsAsyncMethod(string owner, string name) {
        string b = owner;
        var bk = index_of(owner, "<");
        if (bk > 0) b = sub_str(owner, 0, bk);
        Decl dd = this.gProg;
        while (dd != null) {
            if (dd.kind == PK.Fn && dd.owner == b && dd.name == name && dd.isAsync) return true;
            dd = dd.next;
        }
        return false;
    }

    bool IsPrimTy(string t) {
        return t == "mutex" || t == "semaphore" || t == "event" || t == "barrier";
    }

    bool IsActor(string t) {
        string b = t;
        var bk = index_of(t, "<");
        if (bk > 0) b = sub_str(t, 0, bk);
        Decl d = this.gProg;
        while (d != null) {
            if (d.kind == PK.Actor && d.name == b) return true;
            d = d.next;
        }
        return false;
    }

    bool IsInterface(string t) {
        string b = t;
        var bk = index_of(t, "<");
        if (bk > 0) b = sub_str(t, 0, bk);
        Decl d = this.gProg;
        while (d != null) {
            if (d.kind == PK.Interface && d.name == b) return true;
            d = d.next;
        }
        return false;
    }

    void VSlotRegister(string name, int arity) {
        for (int i = 0; i < this.vsN; i++) {
            if (this.vsName[i] == name && this.vsArity[i] == arity) return;
        }
        if (this.vsN < 2040) {
            this.vsName[this.vsN] = name;
            this.vsArity[this.vsN] = arity;
            this.vsN = this.vsN + 1;
        }
    }

    int VSlotOf(string name, int arity) {
        for (int i = 0; i < this.vsN; i++) {
            if (this.vsName[i] == name && this.vsArity[i] == arity) return i;
        }
        return -1;
    }

    string FindMethodImpl(string clsName, string mName, int arity) {
        string cur = clsName;
        int guard = 0;
        while (cur != "" && guard < 32) {
            guard = guard + 1;
            Decl d = this.gProg;
            while (d != null) {
                if (d.kind == PK.Fn && d.owner == cur && d.name == mName) {
                    int ar = 0;
                    Pm p = d.params;
                    while (p != null) {
                        ar = ar + 1;
                        p = p.next;
                    }
                    if (ar - 1 == arity) {
                        return "_sh_" + cur + "_" + mName + "_" + arity;
                    }
                }
                d = d.next;
            }
            string nextBase = "";
            for (int ci = 0; ci < this.cN2; ci++) {
                if (this.cNames[ci] == cur) {
                    nextBase = this.cBase[ci];
                    break;
                }
            }
            cur = nextBase;
        }
        return "";
    }

    Decl FindMethodDecl(string clsName, string mName, int argc) {
        string cur = clsName;
        int guard = 0;
        Decl best = null;
        while (cur != "" && guard < 32) {
            guard = guard + 1;
            Decl d = this.gProg;
            while (d != null) {
                if (d.kind == PK.Fn && d.owner == cur && d.name == mName) {
                    int total = 0;
                    int req = 0;
                    bool seenDef = false;
                    Pm p = d.params;
                    if (p != null) p = p.next;
                    while (p != null) {
                        total = total + 1;
                        if (p.defVal != null) seenDef = true;
                        else if (!seenDef) req = req + 1;
                        p = p.next;
                    }
                    if (argc >= req && argc <= total) return d;
                    if (best == null) best = d;
                }
                d = d.next;
            }
            string nextBase = "";
            for (int ci = 0; ci < this.cN2; ci++) {
                if (this.cNames[ci] == cur) {
                    nextBase = this.cBase[ci];
                    break;
                }
            }
            cur = nextBase;
        }
        return best;
    }

    Decl FindFnDecl(string name, int argc) {
        Decl d = this.gProg;
        Decl best = null;
        while (d != null) {
            if (d.kind == PK.Fn && d.owner == "" && d.name == name) {
                int total = 0;
                int req = 0;
                bool seenDef = false;
                Pm p = d.params;
                while (p != null) {
                    total = total + 1;
                    if (p.defVal != null) seenDef = true;
                    else if (!seenDef) req = req + 1;
                    p = p.next;
                }
                if (argc >= req && argc <= total) return d;
                if (best == null) best = d;
            }
            d = d.next;
        }
        return best;
    }

    Decl FindCtorDecl(string clsName, int argc) {
        Decl d = this.gProg;
        Decl best = null;
        while (d != null) {
            if (d.kind == PK.Fn && d.owner == clsName && d.name == clsName) {
                int total = 0;
                int req = 0;
                bool seenDef = false;
                Pm p = d.params;
                if (p != null) p = p.next;
                while (p != null) {
                    total = total + 1;
                    if (p.defVal != null) seenDef = true;
                    else if (!seenDef) req = req + 1;
                    p = p.next;
                }
                if (argc >= req && argc <= total) return d;
                if (best == null) best = d;
            }
            d = d.next;
        }
        return best;
    }



    // offset em bytes do campo na classe (-1 se ausente)

    int FldOff(string cls, string field) {

        for (int i = 0; i < this.cN2; i++) {

            if (this.cNames[i] != cls) continue;

            string fl = this.cFlds[i];

            var blen = str_len(fl);

            int acc = 1; // slot de cabecalho para classes
            if (this.IsStruct(cls)) acc = 0;

            int start = 0;

            for (int k = 0; k <= blen; k++) {

                if (k == blen || sub_str(fl, k, 1) == ",") {

                    string ent = sub_str(fl, start, k - start);

                    var starV = index_of(ent, "*");

                    int star = (int)starV;

                    string nm = (star > 0) ? sub_str(ent, 0, star) : ent;

                    int szn = 1;

                    if (star > 0) {

                        var szV = parse_int(sub_str(ent, star + 1, str_len(ent) - star - 1));

                        szn = (int)szV;

                    }

                    if (nm == field) return acc * 8;

                    acc = acc + szn;

                    start = k + 1;

                }

            }

            return -1;

        }

        return -1;

    }



    int CntOf(string name) {

        for (int i = 0; i < this.cN2; i++) {

            if (this.cNames[i] == name) return this.cCnt[i];

        }

        return -1;

    }

    int ArrTypeSize(string ty) {
        if (!contains(ty, "[")) return 0;
        int total = 1;
        int n = str_len(ty);
        int i = 0;
        while (i < n) {
            if (sub_str(ty, i, 1) == "[") {
                int j = i + 1;
                string num = "";
                while (j < n && sub_str(ty, j, 1) != "]") {
                    num = num + sub_str(ty, j, 1);
                    j = j + 1;
                }
                if (num != "") {
                    var pv = parse_int(num);
                    total = total * (int)pv;
                }
                i = j;
            }
            i = i + 1;
        }
        return total;
    }

    int ArrSizeOf(string name) {
        for (int i = 0; i < this.lN; i++) {
            if (this.lNames[i] == name) return this.lSizes[i];
        }
        for (int i = 0; i < this.gN; i++) {
            if (this.gNames[i] == name) return this.gSizes[i];
        }
        if (this.curOwner != "") {
            for (int q = 0; q < this.cN2; q++) {
                if (this.cNames[q] != this.curOwner) continue;
                string fl = this.cFlds[q];
                var blen = str_len(fl);
                int start = 0;
                for (int k = 0; k <= blen; k++) {
                    if (k == blen || sub_str(fl, k, 1) == ",") {
                        string ent = sub_str(fl, start, k - start);
                        var starV = index_of(ent, "*");
                        int star = (int)starV;
                        string nm = (star > 0) ? sub_str(ent, 0, star) : ent;
                        if (nm == name && star > 0) {
                            var szV = parse_int(sub_str(ent, star + 1, str_len(ent) - star - 1));
                            return szV;
                        }
                        start = k + 1;
                    }
                }
                break;
            }
        }
        return -1;
    }



    void Emit(string s) {

        // M14.4f: corpo da funÃ§Ã£o vai para buffer prÃ³prio â€” o tamanho da

        // frame (nÂº de slots) sÃ³ Ã© conhecido DEPOIS de gerar o corpo

        // Item 3 Fase 3: spills de parÃ¢metros vÃ£o para buffer prÃ³prio (pLines),
        // emitido antes dos gc_add_root no prÃ³logo (calls clobberam params).

        if (this.inParam == 1) {

            if (this.pn < 16) {

                this.pLines[this.pn] = s;

                this.pn = this.pn + 1;

            }

            return;

        }

        if (this.inBody == 1) {
            if (this.bn < 39990) {
                this.bLines[this.bn] = s;
                this.bn = this.bn + 1;
            }
            return;
        }

        if (this.ln < 349990) {
            this.lines[this.ln] = s;
            this.ln = this.ln + 1;
        }
    }



    string NewLbl(string bse) {

        this.lbl = this.lbl + 1;

        return "." + bse + this.lbl;

    }



    int NewTmp() {

        this.nextSlot = this.nextSlot + 1;

        return this.nextSlot - 1;

    }



    // deslocamento do slot na frame: -(8*(slot+1))(%rbp)

    string Off(int slot) {

        return "" + (0 - 8 * (slot + 1)) + "(%rbp)";

    }



    void FnPut(string name, string ret, int arity) {
        if (this.fN < 2040) {
            this.fNames[this.fN] = name;
            this.fRets[this.fN] = ret;
            this.fArity[this.fN] = arity;
            this.fN = this.fN + 1;
        }
    }



    int FnArityOf(string name) {

        for (int i = 0; i < this.fN; i++) {

            if (this.fNames[i] == name) return this.fArity[i];

        }

        return -1;

    }



    string FnRetOf(string name) {

        for (int i = 0; i < this.fN; i++) {

            if (this.fNames[i] == name) return this.fRets[i];

        }

        return "";

    }



    // slot de um local (-1 se nÃƒÂ£o existe)

    bool LocalAtomic(string name) {
        for (int i = this.lN - 1; i >= 0; i--) {
            if (this.lNames[i] == name) return this.lAtomic[i];
        }
        return false;
    }

    bool GlobalAtomic(string name) {
        for (int i = 0; i < this.gN; i++) {
            if (this.gNames[i] == name) return this.gAtomic[i];
        }
        return false;
    }

    int GlobalTls(string name) {
        for (int i = 0; i < this.gN; i++) {
            if (this.gNames[i] == name) return this.gTlsOff[i];
        }
        return -1;
    }

    int TlsAddrInRax(string name) {
        int off = this.GlobalTls(name);
        this.Emit("subq $32, %rsp");
        this.Emit("call hphl_tls_block");
        this.Emit("addq $32, %rsp");
        this.Emit("leaq " + off + "(%rax), %rax");
        return off;
    }

    int LocalSlot(string name) {

        for (int i = this.lN - 1; i >= 0; i--) {

            if (this.lNames[i] == name) return this.lSlots[i];

        }

        return -1;

    }

    string LocalType(string name) {
        for (int i = this.lN - 1; i >= 0; i--) {
            if (this.lNames[i] == name) return this.lTypes[i];
        }
        return "";
    }

    string LocalRefKind(string name) {
        for (int i = this.lN - 1; i >= 0; i--) {
            if (this.lNames[i] == name) return this.lRefKinds[i];
        }
        return "";
    }

    bool IsByRef(string name) {
        string rk = this.LocalRefKind(name);
        return rk == "ref" || rk == "out" || rk == "in";
    }



    void GenArrFill(int baseS, int size) {
        this.arrBaseF = baseS;
        this.arrSizeF = size;
        int idx = 0;
        int start = 0;
        int n = str_len(this.arrCsv);
        for (int i = 0; i <= n && idx < this.arrSizeF; i++) {
            string ch = ",";
            if (i < n) ch = sub_str(this.arrCsv, i, 1);
            if (ch == "," || ch == ";") {
                string part = sub_str(this.arrCsv, start, i - start);
                if (part != "" && part != "@") {
                    if (contains(part, ".")) {
                        string fl = this.InternFloat(part);
                        this.Emit("movq " + fl + "(%rip), %rax");
                    } else {
                        this.Emit("movq $" + part + ", %rax");
                    }
                    int base = this.arrBaseF + this.arrSizeF - 1;
                    int slot = base - idx;
                    this.Emit("movq %rax, " + this.Off(slot));
                    idx = idx + 1;
                }
                start = i + 1;
            }
        }
    }

    void GenGArrFill() {
        int idx = 0;
        int start = 0;
        int n = str_len(this.arrCsv);
        for (int i = 0; i <= n; i++) {
            string ch = ",";
            if (i < n) ch = sub_str(this.arrCsv, i, 1);
            if (ch == "," || ch == ";") {
                string part = sub_str(this.arrCsv, start, i - start);
                if (part != "" && part != "@") {
                    if (contains(part, ".")) {
                        string fl = this.InternFloat(part);
                        this.Emit("movq " + fl + "(%rip), %rax");
                    } else {
                        this.Emit("movq $" + part + ", %rax");
                    }
                    int off = idx * 8;
                    this.Emit("movq %rax, .Lg_" + this.arrG + "+" + off + "(%rip)");
                    idx = idx + 1;
                }
                start = i + 1;
            }
        }
    }

    int ArrNameSize(string name) {
        for (int q = this.lN - 1; q >= 0; q--) {
            if (this.lNames[q] == name) return this.lSizes[q];
        }
        int gi = this.GlobalIdx(name);
        if (gi >= 0) return this.gSizes[gi];
        return 0;
    }

    void ArrBaseLea(string name, string reg) {
        int li = -1;
        for (int q = this.lN - 1; q >= 0; q--) {
            if (this.lNames[q] == name) { li = q; break; }
        }
        int gi = this.GlobalIdx(name);
        int size = 0;
        if (li >= 0) size = this.lSizes[li];
        if (gi >= 0) size = this.gSizes[gi];
        if (li >= 0) this.Emit("leaq " + this.Off(this.lSlots[li] + size - 1) + ", %" + reg);
        else this.Emit("leaq .Lg_" + name + "(%rip), %" + reg);
    }

    bool GenArrCopy(string destName, string srcName) {
        int dsz = this.ArrNameSize(destName);
        int ssz = this.ArrNameSize(srcName);
        if (dsz <= 0 || ssz <= 0 || dsz != ssz) return false;
        this.Emit("pushq %rdi");
        this.ArrBaseLea(srcName, "rsi");
        this.ArrBaseLea(destName, "rdi");
        this.Emit("movq $" + dsz + ", %rcx");
        this.Emit("rep movsq");
        this.Emit("popq %rdi");
        return true;
    }

    int GlobalIdx(string name) {

        for (int i = 0; i < this.gN; i++) {

            if (this.gNames[i] == name) return i;

        }

        return -1;

    }



    // carrega o valor de uma variÃƒÂ¡vel para %rax

    void LoadVar(string name) {
        // `base` contextual: se ha variavel local/global `base`, ela vence;
        // so usa o ponteiro da base quando nao ha variavel visivel.
        if (name == "base" && this.LocalSlot(name) < 0 && this.GlobalIdx(name) < 0) {
            int thisSlot = this.LocalSlot("this");
            if (thisSlot < 0) thisSlot = 0;
            this.Emit("movq " + this.Off(thisSlot) + ", %rax");
            return;
        }
        int ls = this.LocalSlot(name);
        if (ls >= 0) {
            int asz = this.ArrSizeOf(name);
            if (asz > 0) {
                this.Emit("leaq " + this.Off(ls + asz - 1) + ", %rax");
            } else if (this.IsByRef(name)) {
                this.Emit("movq " + this.Off(ls) + ", %rcx");
                string lty = this.LocalType(name);
                if (this.IsFloatTy(lty)) {
                    this.Emit("movsd (%rcx), %xmm0");
                } else {
                    this.Emit("movq (%rcx), %rax");
                }
            } else {
                this.Emit("movq " + this.Off(ls) + ", %rax");
            }
            return;
        }
        int gi = this.GlobalIdx(name);
        if (gi >= 0) {
            int toff = this.GlobalTls(name);
            if (toff >= 0) {
                this.Emit("subq $32, %rsp");
                this.Emit("call hphl_tls_block");
                this.Emit("addq $32, %rsp");
                this.Emit("movq " + toff + "(%rax), %rax");
                return;
            }
            this.Emit("movq .Lg_" + this.gNames[gi] + "(%rip), %rax");
            return;
        }
        if (this.curOwner != "") {
            int foff = this.FldOff(this.curOwner, name);
            if (foff >= 0) {
                int thisSlot = this.LocalSlot("this");
                if (thisSlot < 0) thisSlot = 0;
                this.Emit("movq " + this.Off(thisSlot) + ", %rcx");
                this.Emit("movq " + foff + "(%rcx), %rax");
                return;
            }
        }
        this.Emit("# ERRO: variavel nao encontrada: " + name);
    }

    void StoreVar(string name) {
        int ls = this.LocalSlot(name);
        if (ls >= 0) {
            if (this.IsByRef(name)) {
                this.Emit("movq " + this.Off(ls) + ", %rcx");
                string lty = this.LocalType(name);
                if (this.IsFloatTy(lty)) {
                    this.Emit("movsd %xmm0, (%rcx)");
                } else {
                    this.Emit("movq %rax, (%rcx)");
                }
                return;
            }
            string polTy = this.LocalType(name);
            if (this.HasPolicy(polTy)) {
                this.EmitPolicy(polTy);
            }
            if (this.LocalAtomic(name)) {
                this.Emit("xchgq %rax, " + this.Off(ls));
            } else {
                this.Emit("movq %rax, " + this.Off(ls));
            }
            return;
        }
        int gi = this.GlobalIdx(name);
        if (gi >= 0) {
            int toff = this.GlobalTls(name);
            if (toff >= 0) {
                int sv = this.NewTmp();
                this.Emit("movq %rax, " + this.Off(sv));
                this.Emit("subq $32, %rsp");
                this.Emit("call hphl_tls_block");
                this.Emit("addq $32, %rsp");
                this.Emit("movq " + this.Off(sv) + ", %rcx");
                this.Emit("movq %rcx, " + toff + "(%rax)");
                return;
            }
            if (this.GlobalAtomic(name)) {
                this.Emit("xchgq %rax, .Lg_" + this.gNames[gi] + "(%rip)");
            } else {
                this.Emit("movq %rax, .Lg_" + this.gNames[gi] + "(%rip)");
            }
            return;
        }
        if (this.curOwner != "") {
            int foff = this.FldOff(this.curOwner, name);
            if (foff >= 0) {
                int thisSlot = this.LocalSlot("this");
                if (thisSlot < 0) thisSlot = 0;
                this.Emit("movq " + this.Off(thisSlot) + ", %rcx");
                this.Emit("movq %rax, " + foff + "(%rcx)");
                return;
            }
        }
    }



    // ------------------------------------------------------------------

    // M15.2.2: interning de strings literais â†’ .asciz na .data

    // ------------------------------------------------------------------

    // M17 Fase 3: string intern dinÃ¢mico via linked list de chunks (StringChunk)
    StringChunk sHead; // primeiro chunk (alocado no constructor)
    StringChunk sTail; // Ãºltimo chunk (para append O(1))

    // Item 3 Fase 2: float intern dinÃ¢mico via linked list de chunks
    FloatChunk fHead; // primeiro chunk (alocado no constructor)
    FloatChunk fTail; // Ãºltimo chunk (para append O(1))
// remove aspas externas do token Str (lexer guarda o literal cru)

    string StripQuotes(string raw) {

        var n = str_len(raw);

        if (n >= 2 && sub_str(raw, 0, 1) == "\"") {

            return sub_str(raw, 1, n - 2);

        }

        return raw;

    }



    string InternStr(string rawLit) {
        string body = this.StripQuotes(rawLit);

        // M17 Fase 3: busca no linked list de chunks
        StringChunk c = this.sHead;
        int globalIdx = 0;
        while (c != null) {
            for (int i = 0; i < c.n; i++) {
                if (c.txts[i] == body) return c.lbls[i];
                globalIdx = globalIdx + 1;
            }
            c = c.next;
        }

        // N\u00e3o encontrado: adiciona no chunk atual (ou cria novo se cheio)
        if (this.sTail.n >= 500) {
            StringChunk nc = new StringChunk();
            nc.n = 0;
            nc.next = null;
            this.sTail.next = nc;
            this.sTail = nc;
        }
        string lbl = ".Lsh_s" + globalIdx;
        this.sTail.lbls[this.sTail.n] = lbl;
        this.sTail.txts[this.sTail.n] = body;
        this.sTail.n = this.sTail.n + 1;
        return lbl;
    }



    // Item 3 Fase 2: interning de literais float â†’ .double na .data.
    // O literal cru ("3.14159") vira `.Lsh_f<N>`; o load usa movq (bits).
    string InternFloat(string rawLit) {
        FloatChunk c = this.fHead;
        int globalIdx = 0;
        while (c != null) {
            for (int i = 0; i < c.n; i++) {
                if (c.txts[i] == rawLit) return c.lbls[i];
                globalIdx = globalIdx + 1;
            }
            c = c.next;
        }
        if (this.fTail.n >= 500) {
            FloatChunk nc = new FloatChunk();
            nc.n = 0;
            nc.next = null;
            this.fTail.next = nc;
            this.fTail = nc;
        }
        string lbl = ".Lsh_f" + globalIdx;
        this.fTail.lbls[this.fTail.n] = lbl;
        this.fTail.txts[this.fTail.n] = rawLit;
        this.fTail.n = this.fTail.n + 1;
        return lbl;
    }




    int AddrOf(Node n) {
        if (n.kind == NK.Var) {
            int ls = this.LocalSlot(n.text);
            if (ls >= 0) {
                if (this.IsByRef(n.text)) {
                    int t = this.NewTmp();
                    this.Emit("movq " + this.Off(ls) + ", %rax");
                    this.Emit("movq %rax, " + this.Off(t));
                    return t;
                }
                int t = this.NewTmp();
                this.Emit("leaq " + this.Off(ls) + ", %rax");
                this.Emit("movq %rax, " + this.Off(t));
                return t;
            }
            int gi = this.GlobalIdx(n.text);
            if (gi >= 0) {
                int t = this.NewTmp();
                this.Emit("leaq .Lg_" + this.gNames[gi] + "(%rip), %rax");
                this.Emit("movq %rax, " + this.Off(t));
                return t;
            }
            if (this.curOwner != "") {
                int foff = this.FldOff(this.curOwner, n.text);
                if (foff >= 0) {
                    int thisSlot = this.LocalSlot("this");
                    if (thisSlot < 0) thisSlot = 0;
                    int t = this.NewTmp();
                    this.Emit("movq " + this.Off(thisSlot) + ", %rax");
                    this.Emit("addq $" + foff + ", %rax");
                    this.Emit("movq %rax, " + this.Off(t));
                    return t;
                }
            }
        }
        if (n.kind == NK.Member) {
            int oT = this.GenExpr(n.left);
            int off = this.FldOff(n.left.tyHint, n.text);
            int t = this.NewTmp();
            this.Emit("movq " + this.Off(oT) + ", %rax");
            if (off != 0) this.Emit("addq $" + off + ", %rax");
            this.Emit("movq %rax, " + this.Off(t));
            return t;
        }
        if (n.kind == NK.Index) {
            if (n.left.kind == NK.Var) {
                string aname = n.left.text;
                int li = -1;
                for (int q = this.lN - 1; q >= 0; q--) {
                    if (this.lNames[q] == aname) { li = q; break; }
                }
                int vI = this.GenExpr(n.right);
                if (li >= 0) {
                    string vty = this.lTypes[li];
                    if (vty == "list" || starts_with(vty, "list")) {
                        this.Emit("movq " + this.Off(this.lSlots[li]) + ", %rcx");
                        this.Emit("movq 16(%rcx), %rcx");
                    } else {
                        int sz = this.lSizes[li];
                        this.Emit("leaq " + this.Off(this.lSlots[li] + sz - 1) + ", %rcx");
                    }
                } else {
                    int gi = this.GlobalIdx(aname);
                    string gty = (gi >= 0) ? this.gTypes[gi] : "";
                    if (gty == "list" || starts_with(gty, "list")) {
                        this.Emit("movq .Lg_" + aname + "(%rip), %rcx");
                        this.Emit("movq 16(%rcx), %rcx");
                    } else {
                        this.Emit("leaq .Lg_" + aname + "(%rip), %rcx");
                    }
                }
                this.Emit("movq " + this.Off(vI) + ", %rax");
                this.Emit("leaq (%rcx,%rax,8), %rax");
                int t = this.NewTmp();
                this.Emit("movq %rax, " + this.Off(t));
                return t;
            } else {
                int bT = this.GenExpr(n.left);
                int iI = this.GenExpr(n.right);
                this.Emit("movq " + this.Off(bT) + ", %rcx");
                string lty = n.left.tyHint;
                if (lty == "list" || starts_with(lty, "list")) {
                    this.Emit("movq 16(%rcx), %rcx");
                }
                this.Emit("movq " + this.Off(iI) + ", %rax");
                this.Emit("leaq (%rcx,%rax,8), %rax");
                int t = this.NewTmp();
                this.Emit("movq %rax, " + this.Off(t));
                return t;
            }
        }
        int vT = this.GenExpr(n);
        int tr = this.NewTmp();
        this.Emit("leaq " + this.Off(vT) + ", %rax");
        this.Emit("movq %rax, " + this.Off(tr));
        return tr;
    }

    // M15-fix3: endereco INLINE de campo-array (this.arr + FldOff);

    // campos-array vivem dentro do objeto, o campo NAO guarda ponteiro

    int AddrOfBase(Node m) {

        int oT = this.GenExpr(m.left);

        int off = this.FldOff(m.left.tyHint, m.text);

        int t = this.NewTmp();

        this.Emit("movq " + this.Off(oT) + ", %rcx");

        this.Emit("leaq " + off + "(%rcx), %rcx");

        this.Emit("movq %rcx, " + this.Off(t));

        return t;

    }

    // ?[i] (safe indexing): bounds-check + None fora dos limites.
    // Espelha compiler/src/codegen/expr_ast.cpp genOptIndex.
    // Valor -> celula Option{tag,payload} (16B); classe/string -> ref ou null.
    int GenTryPost(Node n) {
        string ot = n.left.tyHint;
        if (ot == "" && n.left.kind == NK.Var) ot = this.LocalType(n.left.text);
        bool isOpt = this.IsOptionTy(ot);
        int badTag = 0;
        if (!isOpt) badTag = 1;
        int cellS = this.GenExpr(n.left);
        int tr = this.NewTmp();
        string okL = this.NewLbl("try_ok");
        this.Emit("movq " + this.Off(cellS) + ", %rax");
        this.Emit("movq (%rax), %rdx");
        this.Emit("cmpq $" + badTag + ", %rdx");
        this.Emit("jne " + okL);
        if (isOpt) {
            this.Emit("movq $16, %rcx");
            this.Emit("subq $32, %rsp");
            this.Emit("call hphl_shared_alloc");
            this.Emit("addq $32, %rsp");
            this.Emit("movq $0, %r10");
            this.Emit("movq %r10, 0(%rax)");
            this.Emit("movq %r10, 8(%rax)");
        }
        this.Emit("jmp " + this.fnRetLbl);
        this.Emit(okL + ":");
        this.Emit("movq " + this.Off(cellS) + ", %rax");
        if (n.tyHint == "" || n.tyHint == "void") {
            this.Emit("movq $0, %rax");
            this.Emit("movq %rax, " + this.Off(tr));
        } else {
            this.Emit("movq 8(%rax), %rax");
            this.Emit("movq %rax, " + this.Off(tr));
        }
        return tr;
    }

    int GenOptIndex(Node n) {
        string objTy = n.left.tyHint;
        if (objTy == "" && n.left.kind == NK.Var) objTy = this.LocalType(n.left.text);
        bool isStr = objTy == "string";
        bool isList = objTy == "list" || starts_with(objTy, "list");
        bool refRes = !(starts_with(n.tyHint, "Option<") || starts_with(n.tyHint, "option<"));

        int objS = this.GenExpr(n.left);
        int idxS = this.GenExpr(n.right);

        string lNull = this.NewLbl("opti_null");
        string lDone = this.NewLbl("opti_done");

        // 1. list/string null -> None
        if (isList || isStr) {
            this.Emit("movq " + this.Off(objS) + ", %rax");
            this.Emit("testq %rax, %rax");
            this.Emit("jz " + lNull);
        }
        // 2. idx < 0 -> None
        this.Emit("movq " + this.Off(idxS) + ", %rax");
        this.Emit("cmpq $0, %rax");
        this.Emit("jl " + lNull);
        // 3. idx >= len -> None
        if (isList) {
            this.Emit("movq " + this.Off(objS) + ", %rax");
            this.Emit("movq 0(%rax), %rax");
            this.Emit("cmpq %rax, " + this.Off(idxS));
            this.Emit("jge " + lNull);
        } else if (isStr) {
            this.Emit("movq " + this.Off(objS) + ", %rcx");
            this.Emit("subq $32, %rsp");
            this.Emit("call hphl_str_len");
            this.Emit("addq $32, %rsp");
            this.Emit("cmpq %rax, " + this.Off(idxS));
            this.Emit("jge " + lNull);
        } else {
            int arrSz = -1;
            if (n.left.kind == NK.Var) arrSz = this.ArrSizeOf(n.left.text);
            if (arrSz > 0) {
                this.Emit("cmpq $" + arrSz + ", " + this.Off(idxS));
                this.Emit("jge " + lNull);
            }
        }

        // em limites: carrega elemento em %rax
        if (isStr) {
            this.Emit("movq " + this.Off(objS) + ", %rcx");
            this.Emit("movq " + this.Off(idxS) + ", %rdx");
            this.Emit("subq $32, %rsp");
            this.Emit("call hphl_str_char_index");
            this.Emit("addq $32, %rsp");
        } else if (isList) {
            this.Emit("movq " + this.Off(objS) + ", %rcx");
            this.Emit("movq 16(%rcx), %rcx");
            this.Emit("movq " + this.Off(idxS) + ", %rax");
            this.Emit("movq (%rcx,%rax,8), %rax");
        } else if (n.left.kind == NK.Var) {
            int li2 = -1;
            for (int q = this.lN - 1; q >= 0; q--) {
                if (this.lNames[q] == n.left.text) { li2 = q; break; }
            }
            if (li2 >= 0) {
                int sz2 = this.lSizes[li2];
                this.Emit("leaq " + this.Off(this.lSlots[li2] + sz2 - 1) + ", %rcx");
            } else {
                this.Emit("leaq .Lg_" + n.left.text + "(%rip), %rcx");
            }
            this.Emit("movq " + this.Off(idxS) + ", %rax");
            this.Emit("movq (%rcx,%rax,8), %rax");
        } else {
            int bA = this.AddrOf(n.left);
            this.Emit("movq " + this.Off(bA) + ", %rcx");
            this.Emit("movq " + this.Off(idxS) + ", %rax");
            this.Emit("movq (%rcx,%rax,8), %rax");
        }

        int tr = this.NewTmp();
        if (refRes) {
            this.Emit("movq %rax, " + this.Off(tr));
            this.Emit("jmp " + lDone);
        } else {
            int pay = this.NewTmp();
            this.Emit("movq %rax, " + this.Off(pay));
            this.Emit("movq $16, %rcx");
            this.Emit("subq $32, %rsp");
            this.Emit("call hphl_shared_alloc");
            this.Emit("addq $32, %rsp");
            this.Emit("movq $1, %rcx");
            this.Emit("movq %rcx, 0(%rax)");
            this.Emit("movq " + this.Off(pay) + ", %rcx");
            this.Emit("movq %rcx, 8(%rax)");
            this.Emit("movq %rax, " + this.Off(tr));
            this.Emit("jmp " + lDone);
        }
        this.Emit(lNull + ":");
        if (refRes) {
            this.Emit("movq $0, %rax");
            this.Emit("movq %rax, " + this.Off(tr));
        } else {
            this.Emit("movq $16, %rcx");
            this.Emit("subq $32, %rsp");
            this.Emit("call hphl_shared_alloc");
            this.Emit("addq $32, %rsp");
            this.Emit("movq $0, %rcx");
            this.Emit("movq %rcx, 0(%rax)");
            this.Emit("movq %rcx, 8(%rax)");
            this.Emit("movq %rax, " + this.Off(tr));
        }
        this.Emit(lDone + ":");
        return tr;
    }



    // ------------------------------------------------------------------

    // expressÃµes â€” devolve o slot que contÃ©m o resultado

    // ------------------------------------------------------------------

    void GenMatchBind(string name, string ty, string srcReg, int srcOff) {
        int csl = this.NewTmp();
        this.lNames[this.lN] = name;
        this.lSlots[this.lN] = csl;
        this.lSizes[this.lN] = 0;
        this.lTypes[this.lN] = ty;
        this.lRefKinds[this.lN] = "";
        this.lN = this.lN + 1;
        if (srcOff == 0) {
            this.Emit("movq " + srcReg + ", %rax");
        } else {
            this.Emit("movq " + srcOff + "(" + srcReg + "), %rax");
        }
        this.Emit("movq %rax, " + this.Off(csl));
    }

    void GenMatchPat(Node pat, int subjS, string subjT, string nextL) {
        if (pat == null || pat.kind == NK.MatchWild) return;
        if (pat.kind == NK.Num) {
            int ps = this.GenExpr(pat);
            this.Emit("movq " + this.Off(subjS) + ", %rax");
            this.Emit("movq " + this.Off(ps) + ", %rcx");
            this.Emit("cmpq %rcx, %rax");
            this.Emit("jne " + nextL);
            return;
        }
        if (pat.kind == NK.Str) {
            int ps = this.GenExpr(pat);
            this.Emit("movq " + this.Off(subjS) + ", %rcx");
