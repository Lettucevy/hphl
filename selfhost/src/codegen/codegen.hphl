            Node ac = n.arg;

            int ci = 0;

            while (ac != null && ci < 2) { tc[ci] = this.GenExpr(ac); ci = ci + 1; ac = ac.next; }

            this.Emit("movq " + this.Off(tc[0]) + ", %rcx");

            this.Emit("movq " + this.Off(tc[1]) + ", %rdx");

            this.Emit("subq $32, %rsp");

            this.Emit("call hphl_str_contains");

            this.Emit("addq $32, %rsp");

