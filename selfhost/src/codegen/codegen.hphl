            this.Emit("pushq %rdi");
            this.Emit("pushq %rax");          // salva a base
            this.Emit("movq %rax, %rdi");
            this.Emit("movq $" + bytes + ", %rcx");
            this.Emit("xorl %eax, %eax");
            this.Emit("rep stosb");
            this.Emit("popq %rax");           // rax = base de verdade
            this.Emit("popq %rdi");

