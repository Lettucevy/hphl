                    int kT = this.GenExpr(n.arg);
                    this.Emit("movq " + this.Off(rT) + ", %rcx");
                    this.Emit("movq " + this.Off(kT) + ", %rdx");
                    this.Emit("subq $32, %rsp");
                    this.Emit("call hphl_map_get");
                    this.Emit("addq $32, %rsp");
                    int trG = this.NewTmp();
                    this.Emit("movq %rax, " + this.Off(trG));
                    return trG;
                }
                if (n.text == "Contains") {
                    int rT = this.GenExpr(n.recv);
                    int kT = this.GenExpr(n.arg);
                    this.Emit("movq " + this.Off(rT) + ", %rcx");
                    this.Emit("movq " + this.Off(kT) + ", %rdx");
                    this.Emit("subq $32, %rsp");
                    this.Emit("call hphl_map_contains");
                    this.Emit("addq $32, %rsp");
                    int trC = this.NewTmp();
                    this.Emit("movq %rax, " + this.Off(trC));
                    return trC;
                }
                if (n.text == "Remove") {
                    int rT = this.GenExpr(n.recv);
                    int kT = this.GenExpr(n.arg);
                    this.Emit("movq " + this.Off(rT) + ", %rcx");
                    this.Emit("movq " + this.Off(kT) + ", %rdx");
                    this.Emit("subq $32, %rsp");
                    this.Emit("call hphl_map_remove");
                    this.Emit("addq $32, %rsp");
                    int trR = this.NewTmp();
                    this.Emit("movq %rax, " + this.Off(trR));
                    return trR;
                }
                if (n.text == "Clear") {
                    int rT = this.GenExpr(n.recv);
                    this.Emit("movq " + this.Off(rT) + ", %rcx");
                    this.Emit("subq $32, %rsp");
                    this.Emit("call hphl_map_clear");
                    this.Emit("addq $32, %rsp");
                    int trCl = this.NewTmp();
                    this.Emit("movq $0, %rax");
                    this.Emit("movq %rax, " + this.Off(trCl));
                    return trCl;
                }
            }

            // método: rcx=receptor, demais args rdx/r8/r9

            string mRecvTy = n.recv.tyHint;
            if (mRecvTy == "" && n.recv.kind == NK.Var) mRecvTy = this.LocalType(n.recv.text);
            if (mRecvTy == "mutex" && (n.text == "Lock" || n.text == "Unlock")) {
                int mro = this.GenExpr(n.recv);
                this.Emit("movq " + this.Off(mro) + ", %rcx");
                this.Emit("subq $32, %rsp");
                if (n.text == "Lock") this.Emit("call hphl_mutex_lock");
                else this.Emit("call hphl_mutex_unlock");
                this.Emit("addq $32, %rsp");
                int mtr = this.NewTmp();
                this.Emit("movq $0, %rax");
                this.Emit("movq %rax, " + this.Off(mtr));
                return mtr;
            }
            if (mRecvTy == "semaphore" && (n.text == "Wait" || n.text == "Signal")) {
                int mro = this.GenExpr(n.recv);
                this.Emit("movq " + this.Off(mro) + ", %rcx");
                this.Emit("subq $32, %rsp");
                if (n.text == "Wait") this.Emit("call hphl_semaphore_wait");
                else this.Emit("call hphl_semaphore_signal");
                this.Emit("addq $32, %rsp");
                int mtr = this.NewTmp();
                this.Emit("movq $0, %rax");
                this.Emit("movq %rax, " + this.Off(mtr));
                return mtr;
            }
            if (mRecvTy == "event" && (n.text == "Wait" || n.text == "Set")) {
                int mro = this.GenExpr(n.recv);
                this.Emit("movq " + this.Off(mro) + ", %rcx");
                this.Emit("subq $32, %rsp");
                if (n.text == "Wait") this.Emit("call hphl_event_wait");
                else this.Emit("call hphl_event_set");
                this.Emit("addq $32, %rsp");
                int mtr = this.NewTmp();
                this.Emit("movq $0, %rax");
                this.Emit("movq %rax, " + this.Off(mtr));
                return mtr;
            }
            if (mRecvTy == "barrier" && n.text == "Wait") {
                int mro = this.GenExpr(n.recv);
                this.Emit("movq " + this.Off(mro) + ", %rcx");
                this.Emit("subq $32, %rsp");
                this.Emit("call hphl_barrier_wait");
                this.Emit("addq $32, %rsp");
                int mtr = this.NewTmp();
                this.Emit("movq $0, %rax");
                this.Emit("movq %rax, " + this.Off(mtr));
                return mtr;
            }
            if ((this.IsOptionTy(mRecvTy) || this.IsResultTy(mRecvTy)) &&
                (n.text == "is_some" || n.text == "is_none" || n.text == "unwrap" ||
                 n.text == "unwrap_err" || n.text == "unwrap_or" || n.text == "is_ok" || n.text == "is_err")) {
                int mro = this.GenExpr(n.recv);
                int mtr = this.NewTmp();
                bool mIsRes = this.IsResultTy(mRecvTy);
                if (n.text == "is_some") {
                    this.Emit("movq " + this.Off(mro) + ", %rax");
                    this.Emit("movq 0(%rax), %rax");
                    this.Emit("movq %rax, " + this.Off(mtr));
                } else if (n.text == "is_none") {
                    this.Emit("movq " + this.Off(mro) + ", %rax");
                    this.Emit("movq 0(%rax), %rax");
                    this.Emit("xorq $1, %rax");
                    this.Emit("movq %rax, " + this.Off(mtr));
                } else if (n.text == "is_ok") {
                    this.Emit("movq " + this.Off(mro) + ", %rax");
                    this.Emit("movq 0(%rax), %rax");
                    this.Emit("xorq $1, %rax");
                    this.Emit("movq %rax, " + this.Off(mtr));
                } else if (n.text == "is_err") {
                    this.Emit("movq " + this.Off(mro) + ", %rax");
                    this.Emit("movq 0(%rax), %rax");
                    this.Emit("movq %rax, " + this.Off(mtr));
                } else if (n.text == "unwrap" || n.text == "unwrap_err") {
                    this.Emit("movq " + this.Off(mro) + ", %rax");
                    this.Emit("movq 8(%rax), %rax");
                    this.Emit("movq %rax, " + this.Off(mtr));
                } else if (n.text == "unwrap_or") {
                    int mdef = 0;
                    if (n.arg != null) mdef = this.GenExpr(n.arg);
                    string mElse = this.NewLbl("uo_else");
                    string mDone = this.NewLbl("uo_done");
                    int mGood = 1;
                    if (mIsRes) mGood = 0;
                    this.Emit("movq " + this.Off(mro) + ", %rax");
                    this.Emit("movq 0(%rax), %rax");
                    this.Emit("cmpq $" + mGood + ", %rax");
                    this.Emit("jne " + mElse);
                    this.Emit("movq " + this.Off(mro) + ", %rax");
                    this.Emit("movq 8(%rax), %rax");
                    this.Emit("movq %rax, " + this.Off(mtr));
                    this.Emit("jmp " + mDone);
                    this.Emit(mElse + ":");
                    if (n.arg != null) {
                        this.Emit("movq " + this.Off(mdef) + ", %rax");
                        this.Emit("movq %rax, " + this.Off(mtr));
                    } else {
                        this.Emit("movq $0, %rax");
                        this.Emit("movq %rax, " + this.Off(mtr));
                    }
                    this.Emit(mDone + ":");
                }
                return mtr;
            }

