    int GenBin(Node n) {

        // M15.4: ternario ?:

        if (n.op == "?" && n.right != null && n.arg != null) {

            int t = this.NewTmp();

            this.Emit("movq $0, %rax");

            this.Emit("movq %rax, " + this.Off(t));

            string lElse = this.NewLbl("te");

            string lEnd = this.NewLbl("tx");

            int c = this.GenExpr(n.left);

            this.Emit("movq " + this.Off(c) + ", %rax");

            this.Emit("testq %rax, %rax");

            this.Emit("je " + lElse);

            int va = this.GenExpr(n.right);

            this.Emit("movq " + this.Off(va) + ", %rax");

            this.Emit("movq %rax, " + this.Off(t));

            this.Emit("jmp " + lEnd);

            this.Emit(lElse + ":");

            int vb = this.GenExpr(n.arg);

            this.Emit("movq " + this.Off(vb) + ", %rax");

            this.Emit("movq %rax, " + this.Off(t));

            this.Emit(lEnd + ":");

            return t;

        }

        if (n.op == "??") {
            string qTy = n.left.tyHint;
            if (qTy == "" && n.left.kind == NK.Var) qTy = this.LocalType(n.left.text);
            if (this.IsResultTy(qTy)) {
                int t = this.NewTmp();
