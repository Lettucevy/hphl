            if (off < 0) panic("sh-codegen: campo '" + n.text + "' nao existe em '" + n.left.tyHint + "' recv='" + n.left.text + "'");
            int t = this.NewTmp();
            if (n.op == "?.") {
                string lNull = this.NewLbl("mn");
                string lDone = this.NewLbl("md");
                this.Emit("movq " + this.Off(rT) + ", %rax");
                this.Emit("testq %rax, %rax");
                this.Emit("jz " + lNull);
                this.Emit("movq " + off + "(%rax), %rax");
                this.Emit("movq %rax, " + this.Off(t));
                this.Emit("jmp " + lDone);
                this.Emit(lNull + ":");
                this.Emit("movq $0, %rax");
                this.Emit("movq %rax, " + this.Off(t));
