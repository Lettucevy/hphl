// bench_cpu.hphl: CPU workload benchmark
// Nested loops with arithmetic and branching (~100ms at -O0).

int Collatz(int n) {
    int steps = 0;
    while (n != 1) {
        if (n % 2 == 0) {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        steps += 1;
    }
    return steps;
}

void Main() {
    int total = 0;
    for (int i = 1; i <= 20000; i++) {
        total += Collatz(i);
    }
    print("total steps = ");
    print(total);
    print("\n");
}
