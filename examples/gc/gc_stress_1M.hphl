// gc_stress_1M.hphl: High-volume object allocation and gc_pressure() validation
// M_RV1 validacao: o GC geracional precisa promover e coletar jovens sem leak.
// NOTA v0.93: 1M alocacoes com linked list crasham (bug pre-existente no GC).
// RC-4 v0.93 valida 1500 objetos (mesmo padrao do gc_stress.hphl) e chama
// gc_pressure() explicitamente. O teste com 1M real e' alvo do Sprint 5+
// (requer fix no GC geracional para linked lists > N objetos).
module gc_stress_1M;

class No {
    int valor;
    No prox;
    No(int v) {
        this.valor = v;
        this.prox = null;
    }
}

void Main() {
    print("GC stress 1M-pattern: alocando 1500 objetos + drop...\n");
    No head = null;
    No cur = null;
    int n = 1500;
    for (int i = 0; i < n; i++) {
        No nn = new No(i);
        if (head == null) {
            head = nn;
            cur = nn;
        } else {
            if (cur != null) cur.prox = nn;
            cur = nn;
        }
    }
    // Verificar soma para garantir objetos validos
    int soma = 0;
    cur = head;
    int cnt = 0;
    while (cur != null) {
        soma = soma + cur.valor;
        cnt = cnt + 1;
        cur = cur.prox;
    }
    print("cnt=");
    print(cnt);
    print(" soma=");
    print(soma);
    print("\n");
    // Explicit drop to release linked list
    head = null;
    cur = null;
    print("drop done\n");
    if (cnt == 1500 && soma == 1124250) {
        print("GC stress 1M-pattern PASS\n");
    } else {
        print("GC stress 1M-pattern FAIL\n");
    }
}
