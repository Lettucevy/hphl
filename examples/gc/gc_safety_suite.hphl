// gc_safety_suite.hphl: Safety test suite validating GC correctness
// Edge cases: >64 slots, young/old transitions, root pointers, cycles, shared memory
//
// Each test prints "OK <name>" upon completion.

class Big {
    // 70 campos -> 70 slots, excede o limite conservador de 64 do GC
    // (ver GCerrors.txt item #11). O GC tem que achar a referência viva
    // no slot 69 mesmo via fallback conservador.
    int a00; int a01; int a02; int a03; int a04; int a05; int a06; int a07;
    int a08; int a09; int a10; int a11; int a12; int a13; int a14; int a15;
    int a16; int a17; int a18; int a19; int a20; int a21; int a22; int a23;
    int a24; int a25; int a26; int a27; int a28; int a29; int a30; int a31;
    int a32; int a33; int a34; int a35; int a36; int a37; int a38; int a39;
    int a40; int a41; int a42; int a43; int a44; int a45; int a46; int a47;
    int a48; int a49; int a50; int a51; int a52; int a53; int a54; int a55;
    int a56; int a57; int a58; int a59; int a60; int a61; int a62; int a63;
    int a64; int a65; int a66; int a67; int a68; int a69; // 70 campos
    Big child;  // slot 71 (mas como eh classe, bitmap marca)

    Big(int v) {
        a00 = v; a01 = v; a02 = v; a03 = v; a04 = v; a05 = v; a06 = v; a07 = v;
        a08 = v; a09 = v; a10 = v; a11 = v; a12 = v; a13 = v; a14 = v; a15 = v;
        a16 = v; a17 = v; a18 = v; a19 = v; a20 = v; a21 = v; a22 = v; a23 = v;
        a24 = v; a25 = v; a26 = v; a27 = v; a28 = v; a29 = v; a30 = v; a31 = v;
        a32 = v; a33 = v; a34 = v; a35 = v; a36 = v; a37 = v; a38 = v; a39 = v;
        a40 = v; a41 = v; a42 = v; a43 = v; a44 = v; a45 = v; a46 = v; a47 = v;
        a48 = v; a49 = v; a50 = v; a51 = v; a52 = v; a53 = v; a54 = v; a55 = v;
        a56 = v; a57 = v; a58 = v; a59 = v; a60 = v; a61 = v; a62 = v; a63 = v;
        a64 = v; a65 = v; a66 = v; a67 = v; a68 = v; a69 = v;
        child = null;
    }
    int sum() {
        int s = a00 + a01 + a02 + a03 + a04 + a05 + a06 + a07
              + a08 + a09 + a10 + a11 + a12 + a13 + a14 + a15
              + a16 + a17 + a18 + a19 + a20 + a21 + a22 + a23
              + a24 + a25 + a26 + a27 + a28 + a29 + a30 + a31
              + a32 + a33 + a34 + a35 + a36 + a37 + a38 + a39
              + a40 + a41 + a42 + a43 + a44 + a45 + a46 + a47
              + a48 + a49 + a50 + a51 + a52 + a53 + a54 + a55
              + a56 + a57 + a58 + a59 + a60 + a61 + a62 + a63
              + a64 + a65 + a66 + a67 + a68 + a69;
        if (child != null) s = s + child.sum();
        return s;
    }
}

// Caso P0 #11: objeto >64 slots. Sem precise roots no slot 69, child é
// coletado por engano e sum() lê lixo.
void test_big_obj_root() {
    print("test_big_obj_root... ");
    Big root = new Big(7);
    Big deep = new Big(11);
    root.child = deep;
    // força promoção (cria pressão de GC)
    for (int i = 0; i < 100; i++) {
        Big tmp = new Big(i);
        if (i == 50) { root.child = tmp; }
    }
    gc_pressure();
    int s = root.sum();
    // 70 campos * 7 + (70 * 11 ou 70 * 50) = 490 + 770 ou 3500
    // Aceita 490 + 770 = 1260 OU 490 + 3500 = 3990
    if (s == 1260) print("OK (child=deep)\n");
    else if (s == 3990) print("OK (child=tmp50)\n");
    else { print("FAIL s="); print(s); print("\n"); }
}

// Caso P0 #11: objeto >64 slots onde child está no slot 71 (após 70 ints)
void test_big_obj_deep() {
    print("test_big_obj_deep... ");
    Big big = new Big(5);
    Big deep = new Big(3);
    big.child = deep;
    int expected = 70 * 5 + 70 * 3;  // 350 + 210 = 560
    for (int i = 0; i < 50; i++) {
        Big t = new Big(99);
    }
    gc_pressure();
    int s = big.sum();
    if (s == expected) print("OK\n");
    else { print("FAIL s="); print(s); print(" exp="); print(expected); print("\n"); }
}

// Caso: root -> young -> young (chain simples)
void test_root_young() {
    print("test_root_young... ");
    Big a = new Big(2);
    Big b = new Big(3);
    a.child = b;
    for (int i = 0; i < 100; i++) { Big t = new Big(99); }
    gc_pressure();
    int s = a.sum();
    int expected = 70 * 2 + 70 * 3;  // 140 + 210 = 350
    if (s == expected) print("OK\n");
    else { print("FAIL s="); print(s); print("\n"); }
}

// Caso: ciclo young -> young (o GC tem que tratar ciclo corretamente
// sem seguir a cadeia infinitamente). O GC mark-sweep trata ciclos
// porque marca todos os alcançáveis a partir das roots.
void test_cycle() {
    print("test_cycle... ");
    Big a = new Big(1);
    Big b = new Big(2);
    a.child = b;
    b.child = a;  // ciclo!
    for (int i = 0; i < 100; i++) { Big t = new Big(99); }
    gc_pressure();
    // sum() percorreria o ciclo infinitamente.
    // Verificamos apenas que gc_pressure() nao crashou.
    print("OK (sem crash)\n");
}

void Main() {
    test_big_obj_root();
    test_big_obj_deep();
    test_root_young();
    test_cycle();
    print("done\n");
}
