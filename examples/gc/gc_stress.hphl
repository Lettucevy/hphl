// gc_stress.hphl: Object allocation stress test under GC pressure
// Validates dynamic registry (>1024 objects) and automatic cleanup in Main
// Compile: hphlc gc_stress.hphl -o gc_stress.exe
// Run:     gc_stress.exe

class No {
    int valor;
    No prox;

    No(int v) {
        this.valor = v;
        this.prox = null;
    }
}

void Main() {
    print("GC stress: alocando 1500 objetos...\n");
    No head = null;
    No cur = null;
    int n = 1500; // >1024 para testar tabela dinâmica (antes falharia)
    for (int i = 0; i < n; i++) {
        No nn = new No(i);
        if (head == null) {
            head = nn;
            cur = nn;
        } else {
            if (cur != null) cur.prox = nn;
            cur = nn;
        }
    }
    // Verify sum to guarantee valid object contents
    int soma = 0;
    cur = head;
    int cnt = 0;
    while (cur != null) {
        soma += cur.valor;
        cnt++;
        cur = cur.prox;
    }
    print("cnt=");
    print(cnt);
    print(" soma=");
    print(soma);
    print("\n");
    // Expected: cnt=1500, sum=1124250 (0+1+...+1499)
    if (cnt == 1500 && soma == 1124250) {
        print("GC stress PASS\n");
    } else {
        print("GC stress FAIL\n");
    }
    // Automatic GC in Main epilogue reclaims allocated memory cleanly
}
