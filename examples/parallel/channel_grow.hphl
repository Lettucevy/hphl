// channel_grow.hphl: Dynamically expanding channel buffer capacity
shared int acc = 0;

void Main() {
    channel<int> ch = new channel<int>(2); // cap pequena de proposito
    spawn task {
        // producer pushes values; channel dynamically expands buffer
        int i = 1;
        while (i <= 10) {
            ch.Send(i);
            i = i + 1;
        }
    }
    int got = 0;
    while (got < 10) {
        int v = ch.Receive();
        if (v > 0) acc = acc + v;
        got = got + 1;
    }
    print("soma = ");
    print(acc); // 1+2+...+10 = 55
    print("\n");
}
