// dbg_teste4.hphl: Simple enums in watch expressions and variables pane
enum Estado { Desconectado, Conectado, Pausado = 10, Parado }

Estado g = Estado.Pausado;

void Main() {
	Estado e = Estado.Conectado;
	Estado f = Estado.Parado;
	print("f = ");
	print((int)f);
	print("\n");
	print("e = ");
	print((int)e);
	print("\n");
	print("g = ");
	print((int)g);
	print("\n");
}
