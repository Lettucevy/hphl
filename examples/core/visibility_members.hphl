// visibility_members.hphl: Enforcement of private and protected member access
// private = declaring class only; protected = declaring and derived classes
class Conta {
    private int saldo;
    protected int limite;

    private void Ajustar(int v) { saldo += v; }

    public void Depositar(int v) {
        this.Ajustar(v);
        if (saldo > limite) {
            limite = saldo;
        }
    }
    public int Saldo() { return saldo; }
    public int Limite() { return limite; }
}

class ContaVip : Conta {
    // PROTECTED base field is accessible within derived class
    public int LimiteDobro() { return limite * 2; }
}

void Main() {
    Conta c;
    c.Depositar(50);
    print(c.Saldo());
    println();
    print(c.Limite());
    println();
    ContaVip v;
    v.Depositar(30);
    print(v.LimiteDobro());
    println();
}
