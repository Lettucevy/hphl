// policies_deep.hphl: Memory policy allocators in action:
// arena = bump allocator (bulk-freed at function exit),
// pool = O(1) freelist reuse, shared = atomic reference counting
class Inimigo {
    public int vida;
    public void Hit(int d) { vida -= d; }
}

void Main() {
    arena Inimigo a;
    pool Inimigo p1;
    pool Inimigo p2;
    shared Inimigo s;

    a.Hit(30);
    p1.Hit(10);
    p2.Hit(20);
    s.Hit(5);

    // each object maintains independent state in distinct allocation blocks
    println(a.vida);
    println(p1.vida);
    println(p2.vida);
    println(s.vida);

    heap int x = 7;
    x += 3;
    println(x);
}
