// bench_soma.hphl — benchmark de loop aritmético: 20M somas com soma
// verificável (soma de 0..19.999.999 = 199999990000000 — por isso int<64>:
// o `int` padrão é 32 bits e estouraria). Mede DENTRO do programa com
// clock_ns() e o harness mede o wall-clock do processo.
void Main() {
    int<64> t0 = clock_ns();
    int<64> i = 0;
    int<64> soma = 0;
    while (i < 20000000) {
        soma = soma + i;
        i++;
    }
    int<64> dt = clock_ns() - t0;
    print("soma = ");
    print(soma);
    print("\n");
    print(dt / 1000);
    print(" us (interno)\n");
}