// bench_scaling.hphl — escalabilidade real do scheduler SEM contenção:
// cada worker escreve em seu próprio slot do array de parciais (reduction),
// Main espera os handles (t.Wait()) e soma os parciais no final. O speedup
// deve subir com HPHL_WORKERS (contraste com bench_parallel, onde o atomic
// é o gargalo). spawn é fire-and-forget: SEM Wait() o Main lê os parciais
// antes de os workers terminarem (race).
import Bench;

int<64>[4000000] arr;
int<64>[256] parcial;   // slots independentes: 1 por worker (sem false sharing)

void Main() {
    int<64> t0 = Bench.Now();
    int<64> i = 0;
    while (i < 4000000) {
        arr[i] = i + 1;
        i++;
    }
    int<64> t1 = Bench.Now();

    task<int> ta = spawn {   // task 1: faixa 0..999999
        int<64> s1 = 0;
        int<64> j1 = 0;
        while (j1 < 1000000) { s1 += arr[j1]; j1++; }
        parcial[0] = s1;
        return 0;
    };
    task<int> tb = spawn {   // task 2: faixa 1000000..1999999
        int<64> s2 = 0;
        int<64> j2 = 1000000;
        while (j2 < 2000000) { s2 += arr[j2]; j2++; }
        parcial[1] = s2;
        return 0;
    };
    task<int> tc = spawn {   // task 3: faixa 2000000..2999999
        int<64> s3 = 0;
        int<64> j3 = 2000000;
        while (j3 < 3000000) { s3 += arr[j3]; j3++; }
        parcial[2] = s3;
        return 0;
    };
    task<int> td = spawn {   // task 4: faixa 3000000..3999999
        int<64> s4 = 0;
        int<64> j4 = 3000000;
        while (j4 < 4000000) { s4 += arr[j4]; j4++; }
        parcial[3] = s4;
        return 0;
    };
    ta.Wait();
    tb.Wait();
    tc.Wait();
    td.Wait();
    int<64> t2 = Bench.Now();
    int<64> total = 0;
    i = 0;
    while (i < 4) {
        total += parcial[i];
        i++;
    }
    int<64> t3 = Bench.Now();
    print("reduction = ");
    print(total);
    print("\n");
    Bench.ReportUs("4 tasks em faixas", t2 - t1);
    Bench.ReportUs("soma dos parciais", t3 - t2);
}