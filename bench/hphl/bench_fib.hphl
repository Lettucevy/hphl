int<64> Fib(int n) {
    int<64> a = 0;
    int<64> b = 1;
    for (int<64> i = 0; i < n; i++) {
        int<64> temp = a + b;
        a = b;
        b = temp;
    }
    return a;
}

void Main() {
    int<64> t0 = clock_ns();
    int<64> r = Fib(34);
    int<64> dt = clock_ns() - t0;
    print("fib(34) = ");
    print(r);
    print("\n");
    print(dt / 1000);
    print(" us (interno)\n");
}