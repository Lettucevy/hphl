// bench_parallel.hphl — benchmark de TALENTO da língua: `parallel foreach`
// sobre um array global de 4M elementos (acumulador atomic). Roda com o pool
// padrão; use HPHL_WORKERS no harness para comparar 1 vs N workers.
int<64>[4000000] arr;
atomic int<64> soma = 0;

void Main() {
    int<64> t0 = clock_ns();
    int<64> i = 0;
    while (i < 4000000) {
        arr[i] = i + 1;
        i++;
    }
    int<64> t1 = clock_ns();
    parallel foreach (var x in arr) {
        soma += x;  // RMW atômico (LOCK XADD) — `soma = soma + x` NÃO é atômico
    }
    int<64> dt = clock_ns() - t1;
    print("preencheu em ");
    print((t1 - t0) / 1000);
    print(" us\n");
    print("\n");
    print("soma = ");
    print(soma);
    print("\n");
    print(dt / 1000);
    print(" us para o parallel foreach (interno)\n");
}